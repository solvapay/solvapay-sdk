{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": [
    "sdks/typescript/core/src/**/*",
    "sdks/typescript/server/src/**/*",
    "sdks/typescript/mcp-core/src/**/*",
    "sdks/typescript/mcp/src/**/*",
    "sdks/typescript/react/src/**/*",
    "sdks/typescript/react-supabase/src/**/*",
    "sdks/typescript/next/src/**/*",
    "sdks/typescript/auth/src/**/*"
  ],
  "exclude": [
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/node_modules/**",
    "**/dist/**"
  ]
}
