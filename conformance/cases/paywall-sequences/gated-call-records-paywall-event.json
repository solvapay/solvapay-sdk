{
  "$schema": "../../case.schema.json",
  "suite": "paywall-sequences",
  "case": "gated-call-records-paywall-event",
  "description": "A gated paid call never runs the handler: it records one paywall event, with the tool name, and returns the gate. A second gated call does the same.",
  "setup": {
    "productRef": "prd_sequences"
  },
  "steps": [
    {
      "fn": "paidCall",
      "clock": "2026-11-12T12:00:00.000Z",
      "args": {
        "customerRef": "cus_SEQ07",
        "handler": "succeed",
        "toolName": "search"
      },
      "api": [
        {
          "method": "POST",
          "path": "/v1/sdk/limits",
          "body": {
            "withinLimits": false,
            "remaining": 0,
            "plan": "Pro",
            "meterName": "requests",
            "checkoutUrl": "https://checkout.conformance.test/s/1"
          }
        },
        {
          "method": "POST",
          "path": "/v1/sdk/usages",
          "body": {
            "reference": "usage_1",
            "success": true
          }
        }
      ],
      "expect": {
        "gate": {
          "kind": "payment_required",
          "product": "prd_sequences",
          "checkoutUrl": "https://checkout.conformance.test/s/1",
          "message": "You've reached the included usage for this period. [Open checkout](https://checkout.conformance.test/s/1) to continue (expires in 15 minutes), or call the `account` tool with view: 'checkout'.",
          "planRef": "Pro",
          "meterName": "requests",
          "reason": "limit_reached",
          "nextAction": "checkout",
          "remainingCalls": 0,
          "links": {
            "checkout": "https://checkout.conformance.test/s/1"
          }
        },
        "apiCalls": [
          {
            "method": "POST",
            "path": "/v1/sdk/limits",
            "body": {
              "customerRef": "cus_SEQ07",
              "productRef": "prd_sequences",
              "meterName": "requests",
              "includeCheckoutSession": true
            }
          },
          {
            "method": "POST",
            "path": "/v1/sdk/usages",
            "body": {
              "customerRef": "cus_SEQ07",
              "actionType": "api_call",
              "units": 1,
              "outcome": "paywall",
              "productRef": "prd_sequences",
              "duration": 0,
              "idempotencyKey": "solvapay_1794484800000_<random>:paywall",
              "metadata": {
                "action": "requests",
                "requestId": "solvapay_1794484800000_<random>",
                "toolName": "search"
              },
              "timestamp": "2026-11-12T12:00:00.000Z"
            }
          }
        ]
      }
    },
    {
      "fn": "paidCall",
      "clock": "2026-11-12T12:00:00.100Z",
      "args": {
        "customerRef": "cus_SEQ07",
        "handler": "succeed",
        "toolName": "search"
      },
      "api": [
        {
          "method": "POST",
          "path": "/v1/sdk/limits",
          "body": {
            "withinLimits": false,
            "remaining": 0,
            "plan": "Pro",
            "meterName": "requests",
            "checkoutUrl": "https://checkout.conformance.test/s/1"
          }
        },
        {
          "method": "POST",
          "path": "/v1/sdk/usages",
          "body": {
            "reference": "usage_1",
            "success": true
          }
        }
      ],
      "expect": {
        "gate": {
          "kind": "payment_required",
          "product": "prd_sequences",
          "checkoutUrl": "https://checkout.conformance.test/s/1",
          "message": "You've reached the included usage for this period. [Open checkout](https://checkout.conformance.test/s/1) to continue (expires in 15 minutes), or call the `account` tool with view: 'checkout'.",
          "planRef": "Pro",
          "meterName": "requests",
          "reason": "limit_reached",
          "nextAction": "checkout",
          "remainingCalls": 0,
          "links": {
            "checkout": "https://checkout.conformance.test/s/1"
          }
        },
        "apiCalls": [
          {
            "method": "POST",
            "path": "/v1/sdk/limits",
            "body": {
              "customerRef": "cus_SEQ07",
              "productRef": "prd_sequences",
              "meterName": "requests",
              "includeCheckoutSession": true
            }
          },
          {
            "method": "POST",
            "path": "/v1/sdk/usages",
            "body": {
              "customerRef": "cus_SEQ07",
              "actionType": "api_call",
              "units": 1,
              "outcome": "paywall",
              "productRef": "prd_sequences",
              "duration": 0,
              "idempotencyKey": "solvapay_1794484800100_<random>:paywall",
              "metadata": {
                "action": "requests",
                "requestId": "solvapay_1794484800100_<random>",
                "toolName": "search"
              },
              "timestamp": "2026-11-12T12:00:00.100Z"
            }
          }
        ]
      }
    }
  ]
}
