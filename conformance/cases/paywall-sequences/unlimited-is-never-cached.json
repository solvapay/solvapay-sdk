{
  "$schema": "../../case.schema.json",
  "suite": "paywall-sequences",
  "case": "unlimited-is-never-cached",
  "description": "remaining -1 means unlimited: every call is allowed and every call asks the API, because nothing is counted down.",
  "setup": {
    "productRef": "prd_sequences"
  },
  "steps": [
    {
      "fn": "decide",
      "clock": "2026-11-12T12:00:00.000Z",
      "args": {
        "customerRef": "cus_SEQ04"
      },
      "api": [
        {
          "method": "POST",
          "path": "/v1/sdk/limits",
          "body": {
            "withinLimits": true,
            "remaining": -1,
            "plan": "Pro",
            "meterName": "requests",
            "checkoutUrl": "https://checkout.conformance.test/s/1"
          }
        }
      ],
      "expect": {
        "result": {
          "outcome": "allow",
          "customerRef": "cus_SEQ04"
        },
        "apiCalls": [
          {
            "method": "POST",
            "path": "/v1/sdk/limits",
            "body": {
              "customerRef": "cus_SEQ04",
              "productRef": "prd_sequences",
              "meterName": "requests",
              "includeCheckoutSession": true
            }
          }
        ]
      }
    },
    {
      "fn": "decide",
      "clock": "2026-11-12T12:00:00.100Z",
      "args": {
        "customerRef": "cus_SEQ04"
      },
      "api": [
        {
          "method": "POST",
          "path": "/v1/sdk/limits",
          "body": {
            "withinLimits": true,
            "remaining": -1,
            "plan": "Pro",
            "meterName": "requests",
            "checkoutUrl": "https://checkout.conformance.test/s/1"
          }
        }
      ],
      "expect": {
        "result": {
          "outcome": "allow",
          "customerRef": "cus_SEQ04"
        },
        "apiCalls": [
          {
            "method": "POST",
            "path": "/v1/sdk/limits",
            "body": {
              "customerRef": "cus_SEQ04",
              "productRef": "prd_sequences",
              "meterName": "requests",
              "includeCheckoutSession": true
            }
          }
        ]
      }
    }
  ]
}
