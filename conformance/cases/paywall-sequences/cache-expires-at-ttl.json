{
  "$schema": "../../case.schema.json",
  "suite": "paywall-sequences",
  "case": "cache-expires-at-ttl",
  "description": "Cached limits are used up to, but not at, the TTL: 1 ms before it the cache answers, at exactly the TTL the API is asked again.",
  "setup": {
    "productRef": "prd_sequences",
    "limitsCacheTtlMs": 10000
  },
  "steps": [
    {
      "fn": "decide",
      "clock": "2026-11-12T12:00:00.000Z",
      "args": {
        "customerRef": "cus_SEQ03"
      },
      "api": [
        {
          "method": "POST",
          "path": "/v1/sdk/limits",
          "body": {
            "withinLimits": true,
            "remaining": 5,
            "plan": "Pro",
            "meterName": "requests",
            "checkoutUrl": "https://checkout.conformance.test/s/1"
          }
        }
      ],
      "expect": {
        "result": {
          "outcome": "allow",
          "customerRef": "cus_SEQ03"
        },
        "apiCalls": [
          {
            "method": "POST",
            "path": "/v1/sdk/limits",
            "body": {
              "customerRef": "cus_SEQ03",
              "productRef": "prd_sequences",
              "meterName": "requests",
              "includeCheckoutSession": true
            }
          }
        ]
      }
    },
    {
      "fn": "decide",
      "clock": "2026-11-12T12:00:09.999Z",
      "args": {
        "customerRef": "cus_SEQ03"
      },
      "api": [],
      "expect": {
        "result": {
          "outcome": "allow",
          "customerRef": "cus_SEQ03"
        },
        "apiCalls": []
      }
    },
    {
      "fn": "decide",
      "clock": "2026-11-12T12:00:10.000Z",
      "args": {
        "customerRef": "cus_SEQ03"
      },
      "api": [
        {
          "method": "POST",
          "path": "/v1/sdk/limits",
          "body": {
            "withinLimits": true,
            "remaining": 5,
            "plan": "Pro",
            "meterName": "requests",
            "checkoutUrl": "https://checkout.conformance.test/s/1"
          }
        }
      ],
      "expect": {
        "result": {
          "outcome": "allow",
          "customerRef": "cus_SEQ03"
        },
        "apiCalls": [
          {
            "method": "POST",
            "path": "/v1/sdk/limits",
            "body": {
              "customerRef": "cus_SEQ03",
              "productRef": "prd_sequences",
              "meterName": "requests",
              "includeCheckoutSession": true
            }
          }
        ]
      }
    }
  ]
}
