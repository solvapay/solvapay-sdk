{
  "$schema": "../../case.schema.json",
  "suite": "paywall-sequences",
  "case": "parallel-new-user-created-once",
  "description": "Three calls for a brand-new user arrive together: the customer is looked up and created once, and all three share one limits check.",
  "setup": {
    "productRef": "prd_sequences"
  },
  "steps": [
    {
      "fn": "decideConcurrently",
      "clock": "2026-11-12T12:00:00.000Z",
      "args": {
        "customerRef": "user_seq_15",
        "count": 3
      },
      "api": [
        {
          "method": "GET",
          "path": "/v1/sdk/customers",
          "status": 404,
          "body": {
            "statusCode": 404,
            "message": "Customer not found"
          }
        },
        {
          "method": "POST",
          "path": "/v1/sdk/customers",
          "body": {
            "reference": "cus_SEQ15",
            "email": "x@auto-created.local",
            "name": "user_seq_15"
          }
        },
        {
          "method": "POST",
          "path": "/v1/sdk/limits",
          "body": {
            "withinLimits": true,
            "remaining": 10,
            "plan": "Pro",
            "meterName": "requests",
            "checkoutUrl": "https://checkout.conformance.test/s/1"
          }
        }
      ],
      "expect": {
        "result": ["allow", "allow", "allow"],
        "apiCalls": [
          {
            "method": "GET",
            "path": "/v1/sdk/customers",
            "query": {
              "externalRef": "user_seq_15"
            }
          },
          {
            "method": "POST",
            "path": "/v1/sdk/customers",
            "body": {
              "email": "user_seq_15-1794484800000@auto-created.local",
              "metadata": {},
              "externalRef": "user_seq_15"
            }
          },
          {
            "method": "POST",
            "path": "/v1/sdk/limits",
            "body": {
              "customerRef": "cus_SEQ15",
              "productRef": "prd_sequences",
              "meterName": "requests",
              "includeCheckoutSession": true
            }
          }
        ]
      }
    },
    {
      "fn": "decide",
      "clock": "2026-11-12T12:00:00.100Z",
      "args": {
        "customerRef": "user_seq_15"
      },
      "api": [],
      "expect": {
        "result": {
          "outcome": "allow",
          "customerRef": "cus_SEQ15"
        },
        "apiCalls": []
      }
    }
  ]
}
