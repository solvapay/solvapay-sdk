{
  "$schema": "../../case.schema.json",
  "suite": "paywall-sequences",
  "case": "customer-is-resolved-once",
  "description": "Your user id is looked up by externalRef once. A later call, even on another meter, reuses the mapping and only checks limits.",
  "setup": {
    "productRef": "prd_sequences"
  },
  "steps": [
    {
      "fn": "decide",
      "clock": "2026-11-12T12:00:00.000Z",
      "args": {
        "customerRef": "user_seq_09"
      },
      "api": [
        {
          "method": "GET",
          "path": "/v1/sdk/customers",
          "body": {
            "reference": "cus_SEQ09",
            "email": "user_seq_09@example.com",
            "name": "Ada",
            "externalRef": "user_seq_09"
          }
        },
        {
          "method": "POST",
          "path": "/v1/sdk/limits",
          "body": {
            "withinLimits": true,
            "remaining": 5,
            "plan": "Pro",
            "meterName": "requests",
            "checkoutUrl": "https://checkout.conformance.test/s/1"
          }
        }
      ],
      "expect": {
        "result": {
          "outcome": "allow",
          "customerRef": "cus_SEQ09"
        },
        "apiCalls": [
          {
            "method": "GET",
            "path": "/v1/sdk/customers",
            "query": {
              "externalRef": "user_seq_09"
            }
          },
          {
            "method": "POST",
            "path": "/v1/sdk/limits",
            "body": {
              "customerRef": "cus_SEQ09",
              "productRef": "prd_sequences",
              "meterName": "requests",
              "includeCheckoutSession": true
            }
          }
        ]
      }
    },
    {
      "fn": "decide",
      "clock": "2026-11-12T12:00:00.100Z",
      "args": {
        "customerRef": "user_seq_09",
        "meter": "tokens"
      },
      "api": [
        {
          "method": "POST",
          "path": "/v1/sdk/limits",
          "body": {
            "withinLimits": true,
            "remaining": 5,
            "plan": "Pro",
            "meterName": "tokens",
            "checkoutUrl": "https://checkout.conformance.test/s/1"
          }
        }
      ],
      "expect": {
        "result": {
          "outcome": "allow",
          "customerRef": "cus_SEQ09"
        },
        "apiCalls": [
          {
            "method": "POST",
            "path": "/v1/sdk/limits",
            "body": {
              "customerRef": "cus_SEQ09",
              "productRef": "prd_sequences",
              "meterName": "tokens",
              "includeCheckoutSession": true
            }
          }
        ]
      }
    }
  ]
}
