  "suite": "paywall-sequences",
  "case": "cache-counts-down-then-rechecks",
  "description": "Three units from one limits check: the first call fetches, the next two use the cache, and the fourth asks the API again and is gated.",
  "setup": {
    "productRef": "prd_sequences"
  },
  "steps": [
