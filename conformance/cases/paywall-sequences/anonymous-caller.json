{
  "$schema": "../../case.schema.json",
  "suite": "paywall-sequences",
  "case": "anonymous-caller",
  "description": "A caller with no customer is refused with identity_required before any API call, on a paid check as on a free allowance: there is no shared 'anonymous' customer. An empty customer ref is refused the same way, and so is a paid call, whose handler never runs.",
  "setup": {
    "productRef": "prd_pw_seq"
  },
  "steps": [
    {
      "fn": "decide",
      "clock": "2026-11-13T09:10:00.000Z",
      "args": {
        "customerRef": "anonymous"
      },
      "api": [],
      "expect": {
        "error": {
          "code": "identity_required"
        },
        "apiCalls": []
      }
    },
    {
      "fn": "decide",
      "clock": "2026-11-13T09:10:00.500Z",
      "args": {
        "customerRef": ""
      },
      "api": [],
      "expect": {
        "error": {
          "code": "identity_required"
        },
        "apiCalls": []
      }
    },
    {
      "fn": "paidCall",
      "clock": "2026-11-13T09:10:01.000Z",
      "args": {
        "customerRef": "anonymous",
        "handler": "succeed",
        "toolName": "preview"
      },
      "api": [],
      "expect": {
        "error": {
          "code": "identity_required"
        },
        "apiCalls": []
      }
    }
  ]
}
