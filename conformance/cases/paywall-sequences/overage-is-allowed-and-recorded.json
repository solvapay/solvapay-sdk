        {
          "method": "POST",
          "path": "/v1/sdk/usages",
          "body": {
            "reference": "usage_1",
            "success": true
          }
        }
      ],
      "expect": {
        "result": {
          "ok": true
        },
        "apiCalls": [
          {
            "method": "POST",
            "path": "/v1/sdk/limits",
            "body": {
