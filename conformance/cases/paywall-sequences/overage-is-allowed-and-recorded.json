{
  "$schema": "../../case.schema.json",
  "suite": "paywall-sequences",
  "case": "overage-is-allowed-and-recorded",
  "description": "withinLimits with nothing remaining is overage: the call runs, its usage is recorded as overage, and the next call asks the API again.",
  "setup": {
    "productRef": "prd_sequences"
  },
  "steps": [
    {
      "fn": "paidCall",
      "clock": "2026-11-12T12:00:00.000Z",
      "args": {
        "customerRef": "cus_SEQ05",
        "handler": "succeed",
        "toolName": "search"
      },
      "api": [
        {
          "method": "POST",
          "path": "/v1/sdk/limits",
          "body": {
            "withinLimits": true,
            "remaining": 0,
            "plan": "Pro",
            "meterName": "requests",
            "checkoutUrl": "https://checkout.conformance.test/s/1",
            "overage": true
          }
        },
        {
          "method": "POST",
          "path": "/v1/sdk/usages",
          "body": {
            "reference": "usage_1",
            "success": true
          }
        }
      ],
      "expect": {
        "result": {
          "ok": true
        },
        "apiCalls": [
          {
            "method": "POST",
            "path": "/v1/sdk/limits",
            "body": {
              "customerRef": "cus_SEQ05",
              "productRef": "prd_sequences",
              "meterName": "requests",
              "includeCheckoutSession": true
            }
          },
          {
            "method": "POST",
            "path": "/v1/sdk/usages",
            "body": {
              "customerRef": "cus_SEQ05",
              "actionType": "api_call",
              "units": 1,
              "outcome": "success",
              "productRef": "prd_sequences",
              "duration": 0,
              "idempotencyKey": "solvapay_1794484800000_<random>:success",
              "metadata": {
                "action": "requests",
                "requestId": "solvapay_1794484800000_<random>",
                "toolName": "search",
                "usageClass": "overage"
              },
              "timestamp": "2026-11-12T12:00:00.000Z"
            }
          }
        ]
      }
    },
    {
      "fn": "paidCall",
      "clock": "2026-11-12T12:00:00.100Z",
      "args": {
