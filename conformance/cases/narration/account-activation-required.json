                "currency": "USD"
              },
              {
                "kind": "limit",
                "meter": "requests",
                "cap": 5000,
                "onExceed": "block"
              }
            ]
          },
          {
            "reference": "pln_payg",
            "name": "Pay as you go",
            "type": "usage-based",
            "price": 0,
            "currency": "USD",
            "requiresPayment": true,
            "options": [
              {
                "kind": "charge",
                "per": "unit",
                "amountMinor": 2,
                "currency": "USD",
                "meter": "requests"
              }
            ]
          },
          {
            "reference": "pln_lifetime",
            "name": "Lifetime",
            "type": "one-time",
            "price": 19900,
            "currency": "USD",
