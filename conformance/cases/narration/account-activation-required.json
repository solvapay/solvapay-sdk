{
  "$schema": "../../case.schema.json",
  "suite": "narration",
  "case": "account-activation-required",
  "description": "A customer who must activate (state H) is welcomed with the claimable free plan's allowance and the recovery names activate_plan with its planRef.",
  "input": {
    "fn": "narrateAccount",
    "args": {
      "view": "account",
      "mode": "text",
      "payload": {
        "view": "account",
        "productRef": "prd_research",
        "stripePublishableKey": null,
        "returnUrl": "https://research.example.com",
        "merchant": {
          "displayName": "Acme Data",
          "legalName": "Acme Data Ltd"
        },
        "product": {
          "reference": "prd_research",
          "name": "Stock Research"
        },
        "plans": [
          {
            "reference": "pln_free",
            "name": "Free",
            "type": "recurring",
            "price": 0,
            "currency": "USD",
            "requiresPayment": false,
            "options": [
              {
                "kind": "billingCycle",
                "interval": "month"
              },
              {
                "kind": "limit",
                "meter": "requests",
