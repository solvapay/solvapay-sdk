{
  "$schema": "../../case.schema.json",
  "suite": "narration",
  "case": "checkout-ui-mode",
  "description": "mode ui on the checkout view: the placeholder names the first paid plan and its price, then the narration.",
  "input": {
    "fn": "narrateAccount",
    "args": {
      "view": "checkout",
      "mode": "ui",
      "payload": {
        "view": "checkout",
        "productRef": "prd_research",
        "stripePublishableKey": null,
        "returnUrl": "https://research.example.com",
        "merchant": {
          "displayName": "Acme Data",
          "legalName": "Acme Data Ltd"
        },
        "product": {
          "reference": "prd_research",
          "name": "Stock Research"
        },
        "plans": [
          {
            "reference": "pln_free",
            "name": "Free",
            "type": "recurring",
            "price": 0,
            "currency": "USD",
            "requiresPayment": false,
            "options": [
              {
                "kind": "billingCycle",
                "interval": "month"
              },
              {
                "kind": "limit",
                "meter": "requests",
                "cap": 100,
                "onExceed": "block"
              }
            ]
          },
          {
            "reference": "pln_pro",
            "name": "Pro",
            "type": "recurring",
            "price": 2900,
            "currency": "USD",
            "requiresPayment": true,
            "options": [
              {
                "kind": "billingCycle",
                "interval": "month"
              },
              {
                "kind": "charge",
                "per": "flat",
                "amountMinor": 2900,
                "currency": "USD"
              },
              {
                "kind": "limit",
                "meter": "requests",
                "cap": 5000,
                "onExceed": "block"
              }
            ]
          },
          {
            "reference": "pln_payg",
            "name": "Pay as you go",
            "type": "usage-based",
            "price": 0,
            "currency": "USD",
            "requiresPayment": true,
            "options": [
              {
                "kind": "charge",
                "per": "unit",
                "amountMinor": 2,
                "currency": "USD",
                "meter": "requests"
              }
            ]
          },
          {
            "reference": "pln_lifetime",
            "name": "Lifetime",
            "type": "one-time",
            "price": 19900,
            "currency": "USD",
            "requiresPayment": true,
            "options": [
              {
                "kind": "charge",
                "per": "flat",
                "amountMinor": 19900,
                "currency": "USD"
              }
            ]
          }
        ],
        "customer": {
          "ref": "cus_42",
          "email": "ada@example.com",
          "name": "Ada",
          "purchase": {
            "customerRef": "cus_42",
            "purchases": []
          },
          "paymentMethod": {
            "kind": "none"
          },
          "balance": {
            "credits": 1234567,
            "displayCurrency": "USD",
            "displayExchangeRate": 1,
            "creditsPerMinorUnit": 100
          },
          "usage": null,
          "limits": null
        },
        "checkoutUrl": "https://solvapay.com/customer/checkout?id=cs_1",
        "portalUrl": "https://solvapay.com/customer/manage?session=sess_1",
        "autoRechargeUrl": "https://solvapay.com/customer/manage?session=sess_1&tab=credits&intent=autorecharge"
      }
    },
    "clock": "2026-11-12T12:00:00Z"
  },
  "expect": {
    "result": {
      "content": [
        {
          "type": "text",
          "text": "Opened Stock Research upgrade. Pro · $29.00. Balance: 1,234,567 credits (~$123.46). Checkout: [Open checkout](https://solvapay.com/customer/checkout?id=cs_1) (expires in 15 minutes)."
        },
        {
          "type": "text",
          "text": "**Upgrade — Stock Research**\n\nPlans available:\nFree · no payment required · planRef: pln_free\nPro · recurring · $29.00/month · planRef: pln_pro\nPay as you go · pay as you go · $0.02 / requests · planRef: pln_payg\nLifetime · one-time · $199.00 · planRef: pln_lifetime\n\nTo continue, call `account` with view: \"account\".\nCheckout: [Open checkout](https://solvapay.com/customer/checkout?id=cs_1) (expires in 15 minutes)"
        },
        {
          "type": "resource_link",
          "uri": "https://solvapay.com/customer/checkout?id=cs_1",
          "name": "Open checkout"
        }
      ]
    }
  }
}
