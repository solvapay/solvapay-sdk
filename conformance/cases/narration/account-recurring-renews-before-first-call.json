                      "amountMinor": 2900,
                      "currency": "USD"
                    },
                    {
                      "kind": "limit",
                      "meter": "requests",
                      "cap": 5000,
                      "onExceed": "block"
                    }
                  ]
                },
                "amount": 2900,
                "currency": "USD",
                "startDate": "2026-11-01T00:00:00.000Z",
                "endDate": "2026-12-01T00:00:00.000Z"
              }
            ]
          },
          "paymentMethod": {
            "kind": "none"
          },
          "balance": null,
          "usage": null,
          "limits": null
        },
        "checkoutUrl": null,
        "portalUrl": null,
        "autoRechargeUrl": null
      }
    },
    "clock": "2026-11-12T12:00:00Z"
  },
  "expect": {
    "result": {
      "content": [
        {
          "type": "text",
          "text": "**Stock Research — your account**\n\nStock Research is on Pro, $29 a month. Renews Dec 1. Credits are not used on this plan. Call `account` with view: 'checkout' to switch.\nSigned in as: cus_NR11\n\nTo continue, call `account` with view: \"checkout\"."
        }
