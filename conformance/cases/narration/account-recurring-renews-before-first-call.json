{
  "$schema": "../../case.schema.json",
  "suite": "narration",
  "case": "account-recurring-renews-before-first-call",
  "description": "A recurring plan with an allowance and no usage read yet says when it renews (from the purchase's end date).",
  "input": {
    "fn": "narrateAccount",
    "args": {
      "view": "account",
      "mode": "text",
      "payload": {
        "view": "account",
        "productRef": "prd_nr_renew",
        "stripePublishableKey": null,
        "returnUrl": "https://research.example.com",
        "merchant": {
          "displayName": "Acme Data",
          "legalName": "Acme Data Ltd"
        },
        "product": {
          "reference": "prd_nr_renew",
          "name": "Stock Research"
        },
        "plans": [],
        "customer": {
          "ref": "cus_NR11",
          "email": null,
          "name": null,
          "purchase": {
            "customerRef": "cus_NR11",
            "purchases": [
              {
                "reference": "pur_nr_pro",
                "status": "active",
                "productRef": "prd_nr_renew",
                "planRef": "pln_nr_pro",
                "planSnapshot": {
                  "reference": "pln_nr_pro",
                  "name": "Pro",
                  "price": 2900,
                  "currency": "USD",
                  "options": [
                    {
                      "kind": "billingCycle",
                      "interval": "month"
