{
  "$schema": "../../case.schema.json",
  "suite": "narration",
  "case": "account-recurring-price-without-currency",
  "description": "A recurring plan whose snapshot has a price but no currency names no price, and with no allowance reads as unlimited until the period ends.",
  "input": {
    "fn": "narrateAccount",
    "args": {
      "view": "account",
      "mode": "text",
      "payload": {
        "view": "account",
        "productRef": "prd_nr_nocur",
        "stripePublishableKey": null,
        "returnUrl": "https://research.example.com",
        "merchant": {
          "displayName": "Acme Data",
          "legalName": "Acme Data Ltd"
        },
        "product": {
          "reference": "prd_nr_nocur",
          "name": "Stock Research"
        },
        "plans": [],
        "customer": {
          "ref": "cus_NR12",
          "email": null,
          "name": null,
          "purchase": {
            "customerRef": "cus_NR12",
            "purchases": [
              {
                "reference": "pur_nr_team",
                "status": "active",
                "productRef": "prd_nr_nocur",
                "planRef": "pln_nr_team",
                "planSnapshot": {
                  "reference": "pln_nr_team",
                  "name": "Team",
                  "price": 1000,
                  "options": [
                    {
                      "kind": "billingCycle",
                      "interval": "month"
                    }
                  ]
                },
                "amount": 1000,
                "startDate": "2026-11-01T00:00:00.000Z"
              }
            ]
          },
          "paymentMethod": {
            "kind": "none"
          },
          "balance": null,
          "usage": {
            "meterRef": null,
            "total": null,
            "used": null,
            "remaining": null,
            "percentUsed": null,
            "periodEnd": "2026-12-01T00:00:00.000Z"
          },
          "limits": null
        },
        "checkoutUrl": null,
        "portalUrl": null,
        "autoRechargeUrl": null
      }
    },
    "clock": "2026-11-12T12:00:00Z"
  },
  "expect": {
    "result": {
      "content": [
        {
          "type": "text",
          "text": "**Stock Research — your account**\n\nStock Research is on Team. Unlimited calls, renewing Dec 1. Credits are not used on this plan. Call `account` with view: 'checkout' to switch.\nSigned in as: cus_NR12\n\nTo continue, call `account` with view: \"checkout\"."
        }
      ]
    }
  }
}
