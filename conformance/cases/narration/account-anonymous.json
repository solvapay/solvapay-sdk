{
  "$schema": "../../case.schema.json",
  "suite": "narration",
  "case": "account-anonymous",
  "description": "With no signed-in customer the account view still welcomes and lists the plans, but has no identity, balance, Manage or Checkout rows and no links.",
  "input": {
    "fn": "narrateAccount",
    "args": {
      "view": "account",
      "mode": "auto",
      "payload": {
        "view": "account",
        "productRef": "prd_research",
        "stripePublishableKey": null,
        "returnUrl": "https://research.example.com",
        "merchant": {
          "displayName": "Acme Data",
          "legalName": "Acme Data Ltd"
        },
        "product": {
          "reference": "prd_research",
          "name": "Stock Research"
        },
        "plans": [
          {
            "reference": "pln_free",
            "name": "Free",
            "type": "recurring",
            "price": 0,
            "currency": "USD",
            "requiresPayment": false,
            "options": [
              {
                "kind": "billingCycle",
                "interval": "month"
              },
              {
                "kind": "limit",
                "meter": "requests",
                "cap": 100,
                "onExceed": "block"
              }
            ]
          },
          {
            "reference": "pln_pro",
            "name": "Pro",
            "type": "recurring",
            "price": 2900,
            "currency": "USD",
            "requiresPayment": true,
            "options": [
              {
                "kind": "billingCycle",
                "interval": "month"
              },
              {
                "kind": "charge",
                "per": "flat",
                "amountMinor": 2900,
                "currency": "USD"
              },
              {
                "kind": "limit",
                "meter": "requests",
                "cap": 5000,
                "onExceed": "block"
              }
            ]
          }
        ],
        "customer": null,
        "checkoutUrl": null,
        "portalUrl": null,
        "autoRechargeUrl": null
      }
    },
    "clock": "2026-11-12T12:00:00Z"
  },
  "expect": {
    "result": {
      "content": [
        {
          "type": "text",
          "text": "**Welcome to Stock Research**\n\nStock Research has no plan yet. Free gives 100 calls a month · planRef: pln_free, Pro is $29 a month for 5,000 calls · planRef: pln_pro. Reply with a plan name to activate it.\n\nTo continue, call `account` with view: \"checkout\"."
        }
      ]
    }
  }
}
