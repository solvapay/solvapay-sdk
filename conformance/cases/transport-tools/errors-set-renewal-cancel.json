{
  "$schema": "../../case.schema.json",
  "suite": "transport-tools",
  "case": "errors-set-renewal-cancel",
  "description": "enabled false cancels the purchase (with the reason) and answers the cancelled purchase, unwrapped from the API response.",
  "input": {
    "fn": "callTool",
    "args": {
      "tool": "set_renewal",
      "productRef": "prd_ec_1",
      "customerRef": "cus_EC01",
      "arguments": {
        "purchaseRef": "pur_ec_1",
        "enabled": false,
        "reason": "Too expensive"
      },
      "api": [
        {
          "method": "POST",
          "path": "/v1/sdk/purchases/pur_ec_1/cancel",
          "body": {
            "success": true,
            "purchase": {
              "reference": "pur_ec_1",
              "status": "active",
              "productRef": "prd_ec_1",
              "productName": "Stock Research",
              "planRef": "pln_ec_pro",
              "customerRef": "cus_EC01",
              "amount": 2900,
              "currency": "USD",
              "isRecurring": true,
              "billingCycle": "monthly",
              "startDate": "2026-11-01T00:00:00Z",
              "endDate": "2026-12-01T00:00:00Z",
              "createdAt": "2026-11-01T00:00:00Z",
              "cancelledAt": "2026-11-12T12:00:00Z",
              "cancellationReason": "Too expensive"
            }
          }
        }
      ]
    }
  },
  "expect": {
    "result": {
      "content": [
        {
          "type": "text",
          "json": {
