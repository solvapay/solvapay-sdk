{
  "$schema": "../../case.schema.json",
  "suite": "transport-tools",
  "case": "set-renewal-reactivate",
  "description": "enabled true reactivates the purchase and answers the purchase, unwrapped from the API response.",
  "input": {
    "fn": "callTool",
    "args": {
      "tool": "set_renewal",
      "productRef": "prd_conform1",
      "customerRef": "cus_conform1",
      "arguments": {
        "purchaseRef": "pur_1",
        "enabled": true
      },
      "api": [
        {
          "method": "GET",
          "path": "/v1/sdk/purchases/pur_1",
          "body": {
            "reference": "pur_1",
            "customerRef": "cus_conform1",
            "status": "active"
          }
        },
        {
          "method": "POST",
          "path": "/v1/sdk/purchases/pur_1/reactivate",
          "body": {
            "success": true,
            "purchase": {
              "reference": "pur_1",
              "status": "active",
              "productRef": "prd_conform1",
              "productName": "Stock Research",
              "planRef": "pln_pro",
              "customerRef": "cus_conform1",
              "amount": 2900,
              "currency": "USD",
              "isRecurring": true,
              "billingCycle": "monthly",
              "startDate": "2026-11-01T00:00:00Z",
              "endDate": "2026-12-01T00:00:00Z",
              "createdAt": "2026-11-01T00:00:00Z"
            }
          }
        }
      ]
    }
  },
  "expect": {
    "result": {
      "content": [
        {
          "type": "text",
          "json": {
            "reference": "pur_1",
            "status": "active",
            "productRef": "prd_conform1",
            "productName": "Stock Research",
            "planRef": "pln_pro",
            "customerRef": "cus_conform1",
            "amount": 2900,
            "currency": "USD",
            "isRecurring": true,
            "billingCycle": "monthly",
            "startDate": "2026-11-01T00:00:00Z",
            "endDate": "2026-12-01T00:00:00Z",
            "createdAt": "2026-11-01T00:00:00Z"
          }
        }
      ],
      "structuredContent": {
        "reference": "pur_1",
        "status": "active",
        "productRef": "prd_conform1",
        "productName": "Stock Research",
        "planRef": "pln_pro",
        "customerRef": "cus_conform1",
        "amount": 2900,
        "currency": "USD",
        "isRecurring": true,
        "billingCycle": "monthly",
        "startDate": "2026-11-01T00:00:00Z",
        "endDate": "2026-12-01T00:00:00Z",
        "createdAt": "2026-11-01T00:00:00Z"
      }
    }
  }
}
