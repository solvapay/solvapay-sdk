{
  "$schema": "../../case.schema.json",
  "suite": "transport-tools",
  "case": "activate-plan-activated",
  "description": "activate_plan, which the widget also calls, narrates the activation and answers the API result as structured content.",
  "input": {
    "fn": "callTool",
    "args": {
      "tool": "activate_plan",
      "productRef": "prd_conform1",
      "customerRef": "cus_conform1",
      "arguments": {
        "planRef": "pln_free"
      },
      "api": [
        {
          "method": "POST",
          "path": "/v1/sdk/activate",
          "body": {
            "status": "activated",
            "purchaseRef": "pur_2"
          }
        },
        {
          "method": "GET",
          "path": "/v1/sdk/products/prd_conform1/plans",
          "body": {
            "plans": [
              {
                "reference": "pln_free",
                "name": "Free",
                "type": "recurring",
                "status": "active",
                "isActive": true,
                "requiresPayment": false,
                "price": 0,
                "options": [
                  {
                    "kind": "billingCycle",
                    "interval": "month"
                  }
                ],
                "createdAt": "2026-01-01T00:00:00Z",
                "updatedAt": "2026-01-01T00:00:00Z"
              }
            ]
          }
        }
      ]
    }
  },
  "expect": {
    "result": {
      "content": [
        {
          "type": "text",
          "text": "Activated Free. Paid tools are available now."
        }
      ],
      "structuredContent": {
        "status": "activated",
        "purchaseRef": "pur_2"
      }
    }
  }
}
