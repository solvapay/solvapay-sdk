        "apiCalls": []
      }
    },
    {
      "fn": "releaseCall",
      "args": {
        "requestId": "req_ac_01",
        "reason": "late release"
      },
      "clock": "2026-11-13T12:00:03.000Z",
      "expect": {
        "result": {
          "outcome": "threw",
          "log": []
        },
        "apiCalls": []
      }
    }
  ]
}
