{
  "$schema": "../../case.schema.json",
  "suite": "agent-calls",
  "case": "owner-answers-no-while-waiting",
  "description": "The owner declines, or lets the approval expire, while the call waits: the refusal is SolvaPay's, with its sentence.",
  "setup": {
    "productRef": "prd_ac_calls",
    "agentCalls": {
      "maxWaitSeconds": 30
    }
  },
  "steps": [
    {
      "fn": "beginCall",
      "args": {
        "requestId": "req_ac_21",
        "agentToken": "agk_ac_key01",
        "agent": {
          "agentRef": "agt_ac_01",
          "principalRef": "user_ac_01",
          "promptExcerpt": false,
          "environment": "sandbox"
        },
        "item": "claude-haiku-4-5",
        "estimate": {
          "amount": "0.005142",
          "currency": "USD"
        }
      },
      "clock": "2026-11-13T12:00:00.000Z",
      "api": [
        {
          "method": "POST",
          "path": "/v1/sdk/agent/calls",
          "body": {
            "status": "waiting",
            "callRef": "call_AC21",
            "message": "Waiting for the owner to approve this call.",
            "approval": {
              "reference": "apr_AC21",
              "expiresAt": "2026-11-13T12:10:00.000Z"
            },
            "retryAfterSeconds": 3
          }
        },
        {
          "method": "POST",
          "path": "/v1/sdk/agent/calls",
          "body": {
            "status": "refused",
            "callRef": "call_AC21",
            "reason": "approval_declined",
            "message": "The owner declined this call."
          }
        }
      ],
      "expect": {
        "result": {
          "outcome": {
            "kind": "refused",
            "reason": "approval_declined",
            "message": "The owner declined this call."
          },
          "log": [
            {
              "event": "call.waiting",
