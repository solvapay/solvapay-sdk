            "method": "POST",
            "path": "/v1/sdk/agent/calls",
            "body": {
              "agentToken": "agk_ac_key01",
              "requestId": "req_ac_21",
              "item": "claude-haiku-4-5",
              "estimate": {
                "amount": "0.005142",
                "currency": "USD"
