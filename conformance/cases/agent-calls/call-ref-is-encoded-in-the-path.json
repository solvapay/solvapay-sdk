{
  "$schema": "../../case.schema.json",
  "suite": "agent-calls",
  "case": "call-ref-is-encoded-in-the-path",
  "description": "The call reference is percent-encoded into the complete path, so a reference can never change the path.",
  "setup": {
    "productRef": "prd_ac_calls",
    "agentCalls": {
      "maxWaitSeconds": 0
    }
  },
  "steps": [
    {
      "fn": "beginCall",
      "args": {
        "requestId": "req_ac_70",
        "agentToken": "agk_ac_key01",
        "agent": {
          "agentRef": "agt_ac_01",
          "principalRef": "user_ac_01",
          "promptExcerpt": false,
          "environment": "sandbox"
        },
        "item": "claude-haiku-4-5",
        "estimate": {
          "amount": "0.005142",
          "currency": "USD"
        }
      },
      "clock": "2026-11-13T12:00:00.000Z",
      "api": [
        {
          "method": "POST",
          "path": "/v1/sdk/agent/calls",
          "body": {
            "status": "allowed",
            "callRef": "call/AC 70",
            "reservation": {
              "held": {
                "amount": "0.005142",
                "currency": "USD"
              },
              "expiresAt": "2026-11-13T12:15:00.000Z"
            }
          }
        }
      ],
      "expect": {
        "result": {
          "outcome": {
            "kind": "allow",
            "callRef": "call/AC 70",
            "item": "claude-haiku-4-5",
            "estimate": {
              "amount": "0.005142",
              "currency": "USD"
            },
            "reservation": {
              "held": {
                "amount": "0.005142",
                "currency": "USD"
              },
              "expiresAt": "2026-11-13T12:15:00.000Z"
            }
          },
          "log": [
            {
              "event": "call.allowed",
              "fields": {
                "requestId": "req_ac_70",
                "agentRef": "agt_ac_01",
                "userRef": "user_ac_01",
                "item": "claude-haiku-4-5",
                "estimate": "0.005142 USD",
                "callRef": "call/AC 70"
              }
            }
          ]
        },
        "apiCalls": [
          {
            "method": "POST",
            "path": "/v1/sdk/agent/calls",
            "body": {
              "agentToken": "agk_ac_key01",
              "requestId": "req_ac_70",
              "item": "claude-haiku-4-5",
              "estimate": {
                "amount": "0.005142",
                "currency": "USD"
              },
              "wait": 0
            }
          }
        ]
      }
    },
    {
      "fn": "finishCall",
      "args": {
        "requestId": "req_ac_70",
        "status": 200,
        "cost": {
          "amount": 0.002,
          "currency": "USD"
        }
      },
      "clock": "2026-11-13T12:00:01.000Z",
      "api": [
        {
          "method": "POST",
          "path": "/v1/sdk/agent/calls/call%2FAC%2070/complete",
          "body": {
            "callRef": "call/AC 70",
            "settled": true,
            "source": "reported",
            "amount": {
              "amount": "0.002",
              "currency": "USD"
            },
            "duplicate": false
          }
        }
      ],
      "expect": {
        "result": {
          "outcome": {
            "callRef": "call/AC 70",
            "settled": true,
            "source": "reported",
            "amount": {
              "amount": "0.002",
              "currency": "USD"
            },
            "duplicate": false
          },
          "log": []
        },
        "apiCalls": [
          {
            "method": "POST",
            "path": "/v1/sdk/agent/calls/call%2FAC%2070/complete",
            "body": {
              "status": 200,
              "cost": {
                "amount": "0.002",
                "currency": "USD"
              }
            }
          }
        ]
      }
    }
  ]
}
