{
  "$schema": "../../case.schema.json",
  "suite": "web-routes",
  "case": "merchant-api-error",
  "description": "An API failure is answered with an error, not a fake success.",
  "input": {
    "fn": "webRoute",
    "args": {
      "method": "GET",
      "path": "/api/merchant",
      "user": {
        "id": "user_m2",
        "email": "user_m2@example.com",
        "name": "Ada Lovelace"
      },
      "api": [
        {
          "method": "GET",
          "path": "/v1/sdk/merchant",
          "status": 500,
          "body": {
            "message": "Internal error",
            "code": "internal_error"
          }
        }
      ]
    },
    "clock": "2026-11-14T12:00:00Z"
  },
  "expect": {
    "result": {
      "status": 500,
      "body": {
        "error": "Get merchant failed (500): {\"message\":\"Internal error\",\"code\":\"internal_error\"}",
        "details": "Get merchant failed (500): {\"message\":\"Internal error\",\"code\":\"internal_error\"}"
      },
      "apiCalls": [
        {
          "method": "GET",
          "path": "/v1/sdk/merchant"
        }
      ]
    }
  }
}
