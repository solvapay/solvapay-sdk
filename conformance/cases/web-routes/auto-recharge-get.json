{
  "$schema": "../../case.schema.json",
  "suite": "web-routes",
  "case": "auto-recharge-get",
  "description": "GET auto-recharge returns the user's auto-recharge settings.",
  "input": {
    "fn": "webRoute",
    "args": {
      "method": "GET",
      "path": "/api/auto-recharge",
      "user": {
        "id": "user_ar1",
        "email": "user_ar1@example.com",
        "name": "Ada Lovelace"
      },
      "api": [
        {
          "method": "GET",
          "path": "/v1/sdk/customers",
          "body": {
            "customerRef": "cus_conform1",
            "externalRef": "user_ar1",
            "email": "user_ar1@example.com",
            "name": "Ada Lovelace"
          }
        },
        {
          "method": "GET",
          "path": "/v1/sdk/auto-recharge",
          "body": {
            "enabled": true,
            "thresholdAmount": 500,
            "topupAmount": 2000,
            "currency": "USD"
          }
        }
      ]
    },
    "clock": "2026-11-14T12:00:00Z"
  },
  "expect": {
    "result": {
      "status": 200,
      "body": {
        "enabled": true,
        "thresholdAmount": 500,
        "topupAmount": 2000,
        "currency": "USD"
      },
      "apiCalls": [
        {
          "method": "GET",
          "path": "/v1/sdk/customers",
          "query": "externalRef=user_ar1"
        },
        {
          "method": "GET",
          "path": "/v1/sdk/auto-recharge",
          "query": "customerRef=cus_conform1"
        }
      ]
    }
  }
}
