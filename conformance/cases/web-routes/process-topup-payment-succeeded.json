{
  "$schema": "../../case.schema.json",
  "suite": "web-routes",
  "case": "process-topup-payment-succeeded",
  "description": "process-topup-payment reports success once the customer's balance has gone up.",
  "input": {
    "fn": "webRoute",
    "args": {
      "method": "POST",
      "path": "/api/process-topup-payment",
      "user": {
        "id": "user_tp3",
        "email": "user_tp3@example.com",
        "name": "Ada Lovelace"
      },
      "body": {
        "paymentIntentId": "pi_topup1"
      },
      "api": [
        {
          "method": "GET",
          "path": "/v1/sdk/customers",
          "body": {
            "customerRef": "cus_conform1",
            "externalRef": "user_tp3",
            "email": "user_tp3@example.com",
            "name": "Ada Lovelace"
          }
        },
        {
          "method": "GET",
          "path": "/v1/sdk/customers/cus_conform1/balance",
          "body": {
            "customerRef": "cus_conform1",
            "credits": 0
          }
        },
        {
          "method": "POST",
          "path": "/v1/sdk/payment-intents/pi_topup1/process",
          "body": {
            "status": "succeeded"
          }
        },
        {
          "method": "GET",
          "path": "/v1/sdk/customers/cus_conform1/balance",
          "body": {
            "customerRef": "cus_conform1",
            "credits": 100000
          }
        }
      ]
    },
    "clock": "2026-11-14T12:00:00Z"
  },
  "expect": {
    "result": {
      "status": 200,
      "body": {
        "status": "succeeded",
        "creditsAdded": 100000
      },
      "apiCalls": [
        {
          "method": "GET",
          "path": "/v1/sdk/customers",
          "query": "externalRef=user_tp3"
        },
        {
          "method": "GET",
          "path": "/v1/sdk/customers/cus_conform1/balance"
        },
        {
          "method": "POST",
          "path": "/v1/sdk/payment-intents/pi_topup1/process",
          "body": {
            "customerRef": "cus_conform1"
          }
        },
        {
          "method": "GET",
          "path": "/v1/sdk/customers/cus_conform1/balance"
        }
      ]
    }
  }
}
