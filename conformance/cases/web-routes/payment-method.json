{
  "$schema": "../../case.schema.json",
  "suite": "web-routes",
  "case": "payment-method",
  "description": "payment-method returns the user's saved card.",
  "input": {
    "fn": "webRoute",
    "args": {
      "method": "GET",
      "path": "/api/payment-method",
      "user": {
        "id": "user_pm1",
        "email": "user_pm1@example.com",
        "name": "Ada Lovelace"
      },
      "api": [
        {
          "method": "GET",
          "path": "/v1/sdk/customers",
          "body": {
            "customerRef": "cus_conform1",
            "externalRef": "user_pm1",
            "email": "user_pm1@example.com",
            "name": "Ada Lovelace"
          }
        },
        {
          "method": "GET",
          "path": "/v1/sdk/payment-method",
          "body": {
            "kind": "card",
            "brand": "visa",
            "last4": "4242",
            "expMonth": 12,
            "expYear": 2030
          }
        }
      ]
    },
    "clock": "2026-11-14T12:00:00Z"
  },
  "expect": {
    "result": {
      "status": 200,
      "body": {
        "kind": "card",
        "brand": "visa",
        "last4": "4242",
        "expMonth": 12,
        "expYear": 2030
      },
      "apiCalls": [
        {
          "method": "GET",
          "path": "/v1/sdk/customers",
          "query": "externalRef=user_pm1"
        },
        {
          "method": "GET",
          "path": "/v1/sdk/payment-method",
          "query": "customerRef=cus_conform1"
        }
      ]
    }
  }
}
