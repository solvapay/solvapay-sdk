{
  "$schema": "../../case.schema.json",
  "suite": "web-routes",
  "case": "no-credentials",
  "description": "A request with no credentials is refused with 401 before SolvaPay is called.",
  "input": {
    "fn": "webRoute",
    "args": {
      "method": "GET",
      "path": "/api/check-purchase",
      "user": null,
      "api": []
    },
    "clock": "2026-11-14T12:00:00Z"
  },
  "expect": {
    "result": {
      "status": 401,
      "body": {
        "error": "Unauthorized",
        "details": "User ID not found. Ensure middleware is configured."
      },
      "apiCalls": []
    }
  }
}
