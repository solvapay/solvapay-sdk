{
  "$schema": "../../case.schema.json",
  "suite": "web-routes",
  "case": "customer-balance",
  "description": "customer-balance returns the user's credit balance.",
  "input": {
    "fn": "webRoute",
    "args": {
      "method": "GET",
      "path": "/api/customer-balance",
      "user": {
        "id": "user_cb1",
        "email": "user_cb1@example.com",
        "name": "Ada Lovelace"
      },
      "api": [
        {
          "method": "GET",
          "path": "/v1/sdk/customers",
          "body": {
            "reference": "cus_conform1",
            "name": "Ada Lovelace",
            "email": "user_cb1@example.com",
            "externalRef": "user_cb1"
          }
        },
        {
          "method": "GET",
          "path": "/v1/sdk/customers/cus_conform1/balance",
          "body": {
            "customerRef": "cus_conform1",
            "credits": 250000,
            "displayCurrency": "USD",
            "creditsPerMinorUnit": 100,
            "displayExchangeRate": 1,
            "display": {
              "amountMajor": 25,
              "currency": "USD",
              "formatted": "$25.00",
              "exchangeRate": 1,
              "rateSource": "parity"
            }
          }
        }
      ]
    },
    "clock": "2026-11-14T12:00:00Z"
  },
  "expect": {
    "result": {
      "status": 200,
      "body": {
        "customerRef": "cus_conform1",
        "credits": 250000,
        "displayCurrency": "USD",
        "creditsPerMinorUnit": 100,
        "displayExchangeRate": 1,
        "display": {
          "amountMajor": 25,
          "currency": "USD",
          "formatted": "$25.00",
          "exchangeRate": 1,
          "rateSource": "parity"
        }
      },
      "apiCalls": [
        {
          "method": "GET",
          "path": "/v1/sdk/customers",
          "query": "externalRef=user_cb1"
        },
        {
          "method": "GET",
          "path": "/v1/sdk/customers/cus_conform1/balance"
        }
      ]
    }
  }
}
