{
  "$schema": "../../case.schema.json",
  "suite": "web-routes",
  "case": "list-plans",
  "description": "list-plans returns the product's plans and the product ref.",
  "input": {
    "fn": "webRoute",
    "args": {
      "method": "GET",
      "path": "/api/list-plans",
      "user": {
        "id": "user_lp1",
        "email": "user_lp1@example.com",
        "name": "Ada Lovelace"
      },
      "query": {
        "productRef": "prd_conform1"
      },
      "api": [
        {
          "method": "GET",
          "path": "/v1/sdk/products/prd_conform1/plans",
          "body": {
            "plans": [
              {
                "type": "recurring",
                "reference": "pln_conform1",
                "name": "Pro",
                "options": [
                  {
                    "kind": "billingCycle",
                    "interval": "month"
                  },
                  {
                    "kind": "charge",
                    "per": "flat",
                    "amountMinor": 2000,
                    "currency": "USD"
                  }
                ],
                "isActive": true,
                "status": "active",
                "price": 2000,
                "currency": "USD",
                "createdAt": "2026-10-14T12:00:00Z",
                "updatedAt": "2026-10-14T12:00:00Z"
              }
            ],
            "total": 1,
            "limit": 50,
            "offset": 0
          }
        }
      ]
    },
    "clock": "2026-11-14T12:00:00Z"
  },
  "expect": {
    "result": {
      "status": 200,
      "body": {
        "plans": [
          {
            "type": "recurring",
            "reference": "pln_conform1",
            "name": "Pro",
            "options": [
              {
                "kind": "billingCycle",
                "interval": "month"
              },
              {
                "kind": "charge",
                "per": "flat",
                "amountMinor": 2000,
                "currency": "USD"
              }
            ],
            "isActive": true,
            "status": "active",
            "price": 2000,
            "currency": "USD",
            "createdAt": "2026-10-14T12:00:00Z",
            "updatedAt": "2026-10-14T12:00:00Z"
          }
        ],
        "productRef": "prd_conform1"
      },
      "apiCalls": [
        {
          "method": "GET",
          "path": "/v1/sdk/products/prd_conform1/plans"
        }
      ]
    }
  }
}
