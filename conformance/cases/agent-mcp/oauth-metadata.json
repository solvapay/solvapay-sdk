{
  "$schema": "../../case.schema.json",
  "suite": "agent-mcp",
  "case": "oauth-metadata",
  "description": "With OAuth on, the route serves the RFC 9728 document for GET at the path-suffixed well-known URL and under the MCP path, public and cacheable: the canonical resource (host lowercased, default port and trailing slash dropped), the agent issuer as authorization server, the one scope, the server name and documentation. Other methods and paths are the merchant's.",
  "input": {
    "fn": "agentMcpRoute",
    "args": {
      "issuer": "https://api.solvapay.test/v1/agent",
      "providerRef": "prov_AMCONF01",
      "jwks": {
        "keys": [
          {
            "kty": "EC",
            "x": "VKu9Clta0pxUiCFMZy2_0SznbIfyIdSvlJv7bTnwxhE",
            "y": "KZ5Dl5g06XPQ7bGdwSSlq9KpX6NggQEBK2MRTwYHc84",
            "crv": "P-256",
            "kid": "am-k1",
            "alg": "ES256",
            "use": "sig"
          }
        ]
      },
      "route": {
        "mcpPath": "/mcp",
        "serverName": "am-research",
        "maxWaitSeconds": 0,
        "protectedResource": {
