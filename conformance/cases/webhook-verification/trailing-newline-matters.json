{
  "$schema": "../../case.schema.json",
  "suite": "webhook-verification",
  "case": "trailing-newline-matters",
  "description": "The exact bytes are signed: a body with a trailing newline verifies only against a signature over that newline.",
  "input": {
    "fn": "verifyWebhook",
    "args": {
      "body": "{\"id\":\"evt_0123456789abcdef\",\"type\":\"purchase.created\",\"created\":1794484800,\"api_version\":\"2025-10-01\",\"data\":{\"object\":{\"reference\":\"pur_ABC12345\",\"status\":\"active\"},\"previous_attributes\":null},\"livemode\":false,\"request\":{\"id\":null,\"idempotency_key\":null}}\n",
      "signature": "t=1794484800,v1=88864a9dea020ba8d599542a43206f925a87639f0ebe18fda8c9b21b122c8025",
      "secret": "whsec_conformance_0123456789abcdef0123456789abcdef"
    },
    "clock": "2026-11-12T12:00:00Z"
  },
  "expect": {
    "result": {
      "id": "evt_0123456789abcdef",
      "type": "purchase.created",
      "created": 1794484800,
      "api_version": "2025-10-01",
      "data": {
        "object": {
          "reference": "pur_ABC12345",
          "status": "active"
        },
        "previous_attributes": null
      },
      "livemode": false,
      "request": {
        "id": null,
        "idempotency_key": null
      }
    }
  }
}
