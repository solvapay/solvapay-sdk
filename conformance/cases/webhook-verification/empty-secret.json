{
  "$schema": "../../case.schema.json",
  "suite": "webhook-verification",
  "case": "empty-secret",
  "description": "An empty secret is refused before anything else, even for a delivery correctly signed with an empty key: HMAC accepts a zero-length key, so an unset secret would otherwise verify forged events.",
  "input": {
    "fn": "verifyWebhook",
    "args": {
      "body": "{\"id\":\"evt_0123456789abcdef\",\"type\":\"purchase.created\",\"created\":1794484800,\"api_version\":\"2025-10-01\",\"data\":{\"object\":{\"reference\":\"pur_ABC12345\",\"status\":\"active\"},\"previous_attributes\":null},\"livemode\":false,\"request\":{\"id\":null,\"idempotency_key\":null}}",
      "signature": "t=1794484800,v1=fe6df3b7f12d6ea37eb9f276b5bf7f5787ecade4d74e5f66d532a525b38e8b02",
      "secret": ""
    },
    "clock": "2026-11-12T12:00:00Z"
  },
  "expect": {
    "error": {
      "code": "webhook_secret_missing"
    }
  }
}
