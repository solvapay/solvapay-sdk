{
  "$schema": "../../case.schema.json",
  "suite": "agent-identity",
  "case": "prompt-excerpt-cut-mid-character",
  "description": "When the 1,500-unit cut lands inside a character outside the BMP (an emoji is two UTF-16 units), the excerpt drops that character's lone half instead of sending invalid text, so it is 1,499 units long.",
  "input": {
    "fn": "promptFacts",
    "args": {
      "prompts": {
        "cutThroughEmoji": {
          "parts": [
            {
              "text": "😀"
            }
          ]
        },
        "emojiKeptWhole": {
          "parts": [
            {
              "text": "b😀"
            }
          ]
        }
      }
    }
  },
  "expect": {
    "result": {
      "cutThroughEmoji": {
        "promptHash": "sha256:9ac4c4b1f4d96986230120831e8c03ff668a913870f4ae654e34af0a291ae2db",
        "toolError": false,
        "excerpt": ""
      },
      "emojiKeptWhole": {
        "promptHash": "sha256:a64d45d9163cbe7f2c369d21d77fedf8d54e616b2962cd8504db1451ce6ff8d8",
        "toolError": false,
        "excerpt": "😀"
      }
    }
  }
}
