{
  "$schema": "../../case.schema.json",
  "suite": "agent-identity",
  "case": "identify-credentials",
  "description": "identify tells the credential kinds apart: a merchant API key and anything that is not a JWS (two or four segments, a trailing newline, empty) are not an agent's; an agk_ key goes to SolvaPay only when agent keys are accepted (and agk_ alone is no key), otherwise it is the merchant's or, shaped like a JWS, a token that fails; a JWS is verified as an agent token, expired or from the other environment refused. Agent key answers are cached across identify and verifyAgentKey.",
  "setup": {
    "productRef": "prd_ai_identity"
  },
  "steps": [
    {
      "fn": "identify",
      "clock": "2026-11-13T12:00:00.000Z",
      "args": {
        "issuer": "https://api.conformance.test/v1/agent",
        "providerRef": "prv_ai_merchant",
        "jwks": {
          "keys": [
            {
              "kty": "EC",
              "x": "Xw10l5zMUvgnFhsseGL0OWEo3A_YiNND9OVcJ9CgJHE",
              "y": "RtSB9r9LSWpJ9DgmKFyOh4QaAushFQEAE4k8NWgMkb0",
              "crv": "P-256",
              "kid": "ai-key-1",
              "alg": "ES256",
              "use": "sig"
            }
          ]
        },
        "presentedKey": "sk_live_ai_merchant",
        "acceptAgentKeys": true
      },
      "expect": {
        "result": {
          "kind": "not_agent"
        },
        "apiCalls": []
      }
    },
