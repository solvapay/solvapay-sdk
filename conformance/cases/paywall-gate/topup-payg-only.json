{
  "$schema": "../../case.schema.json",
  "suite": "paywall-gate",
  "case": "topup-payg-only",
  "description": "Out of credits when every paid plan is PAYG becomes activation_required with the PAYG plans, so clients show top-up copy; the message still names topup.",
  "input": {
    "fn": "buildPaywallGate",
    "args": {
      "productRef": "prd_topup",
      "limits": {
        "withinLimits": false,
        "remaining": 0,
        "plan": "pln_payg",
        "checkoutUrl": "https://pay.example.com/checkout",
        "plans": [
          {
            "reference": "pln_payg",
            "name": "Pay as you go",
            "type": "usage-based",
            "price": 1000,
            "currency": "USD",
            "requiresPayment": true
          }
        ],
        "balance": {
          "creditBalance": 0,
          "remainingUnits": 0,
          "creditsPerUnit": 1
        },
        "product": {
          "name": "TopupProduct",
          "ref": "prd_topup",
          "provider": "acme"
        }
      }
    }
  },
  "expect": {
    "result": {
      "kind": "activation_required",
      "product": "prd_topup",
      "message": "Out of credits for this call. Balance 0 credits; this call costs 1 credits — 1 short. [Add credits](https://pay.example.com/checkout) to add credits (expires in 15 minutes), or call the `account` tool with view: 'topup'.",
      "checkoutUrl": "https://pay.example.com/checkout",
      "balance": {
        "creditBalance": 0,
        "remainingUnits": 0,
        "creditsPerUnit": 1
      },
      "productDetails": {
        "name": "TopupProduct",
        "ref": "prd_topup",
        "provider": "acme"
      },
      "planRef": "pln_payg",
      "plans": [
        {
          "reference": "pln_payg",
          "name": "Pay as you go",
          "type": "usage-based",
          "price": 1000,
          "currency": "USD",
          "requiresPayment": true
        }
      ],
      "creditBalance": 0,
      "reason": "topup_required",
      "nextAction": "topup",
      "creditsPerCall": 1,
      "shortfallCredits": 1,
      "remainingCalls": 0,
      "links": {
        "checkout": "https://pay.example.com/checkout"
      }
    }
  }
}
