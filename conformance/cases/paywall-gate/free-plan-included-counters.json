{
  "$schema": "../../case.schema.json",
  "suite": "paywall-gate",
  "case": "free-plan-included-counters",
  "description": "A hybrid free plan at cap carries included counters, the unit price and the meter name, and the message prices the next unit.",
  "input": {
    "fn": "buildPaywallGate",
    "args": {
      "productRef": "prd_x",
      "limits": {
        "withinLimits": false,
        "remaining": 0,
        "plan": "plan_free",
        "checkoutUrl": "https://pay.example.com/checkout",
        "meterName": "api_requests",
        "plans": [
          {
            "reference": "plan_free",
            "name": "Free",
            "type": "hybrid",
            "price": 0,
            "currency": "USD",
            "requiresPayment": false,
            "freeUnits": 3,
            "perUnitChargeMinor": 2
          }
        ]
      }
    }
  },
  "expect": {
    "result": {
      "kind": "payment_required",
      "product": "prd_x",
      "checkoutUrl": "https://pay.example.com/checkout",
      "message": "You've used 3 of 3 included api requests this period. The next call is $0.02. [Open checkout](https://pay.example.com/checkout) to continue (expires in 15 minutes), or call the `account` tool with view: 'checkout'.",
      "planRef": "plan_free",
      "plans": [
        {
          "reference": "plan_free",
          "name": "Free",
          "type": "hybrid",
          "price": 0,
          "currency": "USD",
          "requiresPayment": false,
          "freeUnits": 3,
          "perUnitChargeMinor": 2
        }
      ],
      "meterName": "api_requests",
      "unitPriceMinor": 2,
      "currency": "USD",
      "included": {
        "total": 3,
        "used": 3,
        "remaining": 0
      },
      "reason": "limit_reached",
      "nextAction": "checkout",
      "remainingCalls": 0,
      "links": {
        "checkout": "https://pay.example.com/checkout"
      }
    }
  }
}
