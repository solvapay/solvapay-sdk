{
  "$schema": "../../case.schema.json",
  "suite": "paywall-gate",
  "case": "activation-without-confirmation-url",
  "description": "An activation gate without a confirmation URL falls back to the checkout URL.",
  "input": {
    "fn": "buildPaywallGate",
    "args": {
      "productRef": "prd_x",
      "limits": {
        "withinLimits": false,
        "remaining": 0,
        "plan": "free",
        "checkoutUrl": "https://pay.example.com/checkout",
        "activationRequired": true
      }
    }
  },
  "expect": {
    "result": {
      "kind": "activation_required",
      "product": "prd_x",
      "message": "Your plan needs activation. [Open checkout](https://pay.example.com/checkout) to activate (expires in 15 minutes), or call the `account` tool with view: 'checkout'. Or call `activate_plan` with a `planRef`.",
      "checkoutUrl": "https://pay.example.com/checkout",
      "planRef": "free",
      "reason": "activation_required",
      "nextAction": "activate",
      "remainingCalls": 0,
      "links": {
        "checkout": "https://pay.example.com/checkout"
      }
    }
  }
}
