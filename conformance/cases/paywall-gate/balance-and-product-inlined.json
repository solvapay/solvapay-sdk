{
  "$schema": "../../case.schema.json",
  "suite": "paywall-gate",
  "case": "balance-and-product-inlined",
  "description": "A payment_required gate carries the balance and the product details when the API sends them.",
  "input": {
    "fn": "buildPaywallGate",
    "args": {
      "productRef": "prd_x",
      "limits": {
        "withinLimits": false,
        "remaining": 0,
        "plan": "free",
        "checkoutUrl": "https://pay.example.com/checkout",
        "balance": {
          "creditBalance": 0,
          "remainingUnits": 0,
          "creditsPerUnit": 1
        },
        "product": {
          "name": "API",
          "ref": "prd_x",
          "provider": "acme"
        }
      }
    }
  },
  "expect": {
    "result": {
      "kind": "payment_required",
      "product": "prd_x",
      "checkoutUrl": "https://pay.example.com/checkout",
      "message": "Out of credits for this call. Balance 0 credits; this call costs 1 credits — 1 short. [Add credits](https://pay.example.com/checkout) to add credits (expires in 15 minutes), or call the `account` tool with view: 'topup'.",
      "balance": {
        "creditBalance": 0,
        "remainingUnits": 0,
        "creditsPerUnit": 1
      },
      "productDetails": {
        "name": "API",
        "ref": "prd_x",
        "provider": "acme"
      },
      "planRef": "free",
      "creditBalance": 0,
      "reason": "topup_required",
      "nextAction": "topup",
      "creditsPerCall": 1,
      "shortfallCredits": 1,
      "remainingCalls": 0,
      "links": {
        "checkout": "https://pay.example.com/checkout"
      }
    }
  }
}
