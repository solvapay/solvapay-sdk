                  },
                  {
                    "kind": "limit",
                    "cap": 100
                  }
                ],
                "isActive": true,
                "createdAt": "2026-01-01T00:00:00Z",
                "updatedAt": "2026-01-01T00:00:00Z",
                "requiresPayment": false,
                "price": 0
              },
              {
                "reference": "pln_tl_pro",
                "name": "Pro",
                "type": "recurring",
                "status": "active",
                "options": [
                  {
                    "kind": "billingCycle",
                    "interval": "month"
                  }
                ],
                "isActive": true,
                "createdAt": "2026-01-01T00:00:00Z",
                "updatedAt": "2026-01-01T00:00:00Z",
                "requiresPayment": true,
                "price": 2900,
                "currency": "USD"
              }
            ]
          }
        }
      ]
    }
