{
  "$schema": "../../case.schema.json",
  "suite": "tool-descriptors",
  "case": "bootstrap-resource-anonymous",
  "description": "solvapay://bootstrap.json reads the same snapshot account answers without a view: for no signed-in customer, the catalog with view checkout.",
  "input": {
    "fn": "readResource",
    "args": {
      "productRef": "prd_tl_boot",
      "uri": "solvapay://bootstrap.json",
      "api": [
        {
          "method": "GET",
          "path": "/v1/sdk/platform-config",
          "body": {
            "stripePublishableKey": "pk_test_tl"
          }
        },
        {
          "method": "GET",
          "path": "/v1/sdk/merchant",
          "body": {
            "displayName": "Acme",
            "legalName": "Acme Ltd"
          }
        },
        {
          "method": "GET",
          "path": "/v1/sdk/products/prd_tl_boot",
          "body": {
            "reference": "prd_tl_boot",
            "name": "Stock Research",
            "status": "active",
            "balance": 0,
            "isManagedMcp": false,
            "isMcpPay": false,
            "totalTransactions": 0,
            "createdAt": "2026-01-01T00:00:00Z",
            "updatedAt": "2026-01-01T00:00:00Z"
          }
        },
        {
          "method": "GET",
          "path": "/v1/sdk/products/prd_tl_boot/plans",
