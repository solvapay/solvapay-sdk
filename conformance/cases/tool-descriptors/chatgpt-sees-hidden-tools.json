{
  "$schema": "../../case.schema.json",
  "suite": "tool-descriptors",
  "case": "chatgpt-sees-hidden-tools",
  "description": "ChatGPT (client name matching openai-mcp) still gets every tool when hideToolsByAudience is set, since its iframe can only call listed tools; with views [] the account tool and the view prompts are left out.",
  "input": {
    "fn": "describeServer",
    "args": {
      "productRef": "prd_tl_catalog",
      "views": [],
      "hideToolsByAudience": ["ui"],
      "clientName": "openai-mcp/1.0.0 (ChatGPT)"
    }
  },
  "expect": {
    "result": {
      "tools": [
        {
          "name": "activate_plan",
          "title": "Activate plan",
          "description": "Call when the user says \"activate\" and a specific `planRef` is known. Free plans activate immediately; usage-based plans activate when the balance covers usage; paid plans open checkout. Requires `planRef` — to list or pick a plan, call `account` with view: \"checkout\".",
          "annotations": {
            "openWorldHint": true,
            "readOnlyHint": false,
            "destructiveHint": false,
            "idempotentHint": true
          },
          "_meta": {
            "openai/widgetAccessible": true
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "planRef": {
                "type": "string",
                "description": "Plan to activate. Required."
              },
              "productRef": {
                "type": "string"
              }
            },
            "required": ["planRef"]
          }
        },
        {
          "name": "attach_business_details",
          "description": "UI-only; agents should prefer `account` / `activate_plan`. Attach business purchase details to a payment intent and retrieve the computed tax breakdown.",
          "annotations": {
            "openWorldHint": true,
            "readOnlyHint": false,
            "destructiveHint": false,
            "idempotentHint": true
          },
          "_meta": {
            "ui": {
              "resourceUri": "ui://conformance/mcp-app.html",
              "visibility": ["app"]
            },
            "audience": "ui",
            "openai/widgetAccessible": true,
            "openai/visibility": "private",
            "ui/resourceUri": "ui://conformance/mcp-app.html"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "businessName": {
                "type": "string"
              },
              "country": {
                "type": "string"
              },
              "customerCountry": {
                "type": "string"
              },
              "customerName": {
                "type": "string"
              },
              "customerPostalCode": {
                "type": "string"
              },
              "customerState": {
                "type": "string"
              },
              "isBusiness": {
                "type": "boolean"
              },
              "paymentIntentId": {
                "type": "string"
              },
              "taxId": {
                "type": "string"
              },
              "taxIdType": {
                "type": "string",
                "enum": [
                  "ae_trn",
                  "al_tin",
                  "am_tin",
                  "ao_tin",
                  "au_abn",
                  "aw_tin",
                  "az_tin",
                  "ba_tin",
                  "bb_tin",
                  "bd_bin",
                  "bf_ifu",
                  "bh_vat",
                  "bj_ifu",
                  "bs_tin",
                  "by_tin",
                  "ca_gst_hst",
                  "cd_nif",
                  "ch_vat",
                  "cl_tin",
                  "cm_niu",
                  "co_nit",
                  "cr_tin",
                  "cv_nif",
                  "ec_ruc",
                  "eg_tin",
                  "et_tin",
                  "eu_vat",
                  "gb_vat",
                  "ge_vat",
                  "gn_nif",
                  "hk_br",
                  "id_npwp",
                  "in_gst",
                  "is_vat",
                  "jp_trn",
                  "ke_pin",
                  "kg_tin",
                  "kh_tin",
                  "kr_brn",
                  "kz_bin",
                  "la_tin",
                  "li_vat",
                  "lk_vat",
                  "ma_vat",
                  "md_vat",
                  "me_pib",
                  "mk_vat",
                  "mr_nif",
                  "mx_rfc",
                  "my_sst",
                  "ng_tin",
                  "no_vat",
                  "np_pan",
                  "nz_gst",
                  "om_vat",
                  "pe_ruc",
                  "ph_tin",
                  "rs_pib",
                  "ru_inn",
                  "sa_vat",
                  "sg_gst",
                  "sn_ninea",
                  "sr_fin",
                  "th_vat",
                  "tj_tin",
                  "tr_tin",
                  "tw_vat",
                  "tz_vat",
                  "ua_vat",
                  "ug_tin",
                  "us_ein",
                  "uy_ruc",
                  "uz_vat",
                  "vn_tin",
                  "za_vat",
                  "zm_tin",
                  "zw_tin"
                ]
              }
            },
            "required": ["isBusiness", "paymentIntentId"]
          }
        },
        {
          "name": "create_hosted_session",
          "description": "UI-only; agents should prefer `account` / `activate_plan`. Create a SolvaPay hosted session and return its URL. Pass kind: \"checkout\" for a hosted checkout URL (fallback when Stripe Elements is blocked) or kind: \"portal\" for the customer portal URL.",
          "annotations": {
            "openWorldHint": true,
            "readOnlyHint": false,
            "destructiveHint": false,
            "idempotentHint": true
          },
          "_meta": {
            "ui": {
              "resourceUri": "ui://conformance/mcp-app.html",
              "visibility": ["app"]
            },
            "audience": "ui",
            "openai/widgetAccessible": true,
            "openai/visibility": "private",
            "ui/resourceUri": "ui://conformance/mcp-app.html"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["checkout", "portal"],
                "description": "\"checkout\" for hosted checkout; \"portal\" for customer portal."
              },
              "planRef": {
                "type": "string"
              },
              "productRef": {
                "type": "string"
              }
            },
            "required": ["kind"]
          }
        },
        {
          "name": "create_payment_intent",
          "description": "UI-only; agents should prefer `account` / `activate_plan`. Create a Stripe payment intent for the authenticated customer. Pass purpose: \"plan\" to purchase a plan (returns { clientSecret, publishableKey, accountId?, customerRef }) or purpose: \"topup\" for a credit top-up (credits are recorded by webhook after confirmation). A topup may carry autoRecharge so the card entered for the top-up is saved as the auto-recharge funding source.",
          "annotations": {
            "openWorldHint": true,
            "readOnlyHint": false,
            "destructiveHint": false
          },
          "_meta": {
            "ui": {
              "resourceUri": "ui://conformance/mcp-app.html",
              "visibility": ["app"]
            },
            "audience": "ui",
            "openai/widgetAccessible": true,
            "openai/visibility": "private",
            "ui/resourceUri": "ui://conformance/mcp-app.html"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "amount": {
                "type": "integer",
                "maximum": 9007199254740991,
                "exclusiveMinimum": 0
              },
              "autoRecharge": {
                "type": "object",
                "properties": {
                  "currency": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 3
                  },
                  "enabled": {
                    "type": "boolean"
                  },
                  "maxMonthlySpendMajor": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "thresholdAmountMajor": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "topupAmountMajor": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "triggerType": {
                    "type": "string",
                    "const": "balance"
                  }
                },
                "required": ["currency", "enabled", "triggerType"]
              },
              "currency": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "planRef": {
                "type": "string"
              },
              "productRef": {
                "type": "string"
              },
              "purpose": {
                "type": "string",
                "enum": ["plan", "topup"],
                "description": "\"plan\" for plan checkout; \"topup\" for credit top-up."
              }
            },
            "required": ["purpose"]
          }
        },
        {
          "name": "get_history",
          "description": "UI-only; agents should prefer `account` / `activate_plan`. Load product charge history and account-wide credit activity for the authenticated customer. Charges come from purchases for this product; credit activity is every credit event on the account.",
          "annotations": {
            "openWorldHint": true,
            "readOnlyHint": true,
            "idempotentHint": true
          },
          "_meta": {
            "ui": {
              "resourceUri": "ui://conformance/mcp-app.html",
              "visibility": ["app"]
            },
            "audience": "ui",
            "openai/widgetAccessible": true,
            "openai/visibility": "private",
            "ui/resourceUri": "ui://conformance/mcp-app.html"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "limit": {
                "type": "integer",
                "maximum": 100,
                "exclusiveMinimum": 0
              },
              "productRef": {
                "type": "string"
              }
            },
            "required": []
          }
        },
        {
          "name": "process_payment",
          "description": "UI-only; agents should prefer `account` / `activate_plan`. Process a Stripe payment intent after client-side confirmation and create the SolvaPay purchase. Call after confirmPayment resolves to short-circuit webhook latency.",
          "annotations": {
            "openWorldHint": true,
            "destructiveHint": true
          },
          "_meta": {
            "ui": {
              "resourceUri": "ui://conformance/mcp-app.html",
              "visibility": ["app"]
            },
            "audience": "ui",
            "openai/widgetAccessible": true,
            "openai/visibility": "private",
            "ui/resourceUri": "ui://conformance/mcp-app.html"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "paymentIntentId": {
                "type": "string"
              },
              "planRef": {
                "type": "string"
              },
              "productRef": {
                "type": "string"
              }
            },
            "required": ["paymentIntentId", "productRef"]
          }
        },
        {
          "name": "set_renewal",
          "description": "UI-only; agents should prefer `account` / `activate_plan`. Toggle auto-renewal on an active purchase. Pass enabled: false to cancel (access continues until period end) or enabled: true to undo a pending cancellation.",
          "annotations": {
            "openWorldHint": true,
            "destructiveHint": true,
            "idempotentHint": true
          },
          "_meta": {
            "ui": {
              "resourceUri": "ui://conformance/mcp-app.html",
              "visibility": ["app"]
            },
            "audience": "ui",
            "openai/widgetAccessible": true,
            "openai/visibility": "private",
            "ui/resourceUri": "ui://conformance/mcp-app.html"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean",
                "description": "true to reactivate auto-renewal; false to cancel renewal."
              },
              "purchaseRef": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": ["enabled", "purchaseRef"]
          }
        }
      ],
      "prompts": [
        {
          "name": "activate_plan",
          "title": "Activate plan",
          "description": "Activate a specific plan by ref, or list plans to pick from.",
          "arguments": [
            {
              "name": "planRef",
              "required": false
            }
          ]
        }
      ],
      "resources": [
        {
          "uri": "docs://solvapay/overview.md",
          "name": "SolvaPay MCP — overview",
          "title": "SolvaPay overview",
          "description": "Agent-facing \"start here\" doc — explains the two intent tools, dual-audience fallback, and auth model before any tool is called.",
          "mimeType": "text/markdown"
        },
        {
          "uri": "solvapay://bootstrap.json",
          "name": "SolvaPay bootstrap",
          "title": "SolvaPay bootstrap",
          "description": "Current merchant/product/plans/customer snapshot for the embedded UI. Widgets read this idempotently when the host scrubs structuredContent from tool results.",
          "mimeType": "application/json"
        },
        {
          "uri": "ui://conformance/mcp-app.html",
          "name": "ui://conformance/mcp-app.html",
          "mimeType": "text/html;profile=mcp-app",
          "_meta": {
            "ui": {
              "csp": {
                "resourceDomains": [
                  "https://js.stripe.com",
                  "https://*.stripe.com",
                  "https://b.stripecdn.com",
                  "https://assets.claude.ai",
                  "https://api.conformance.test"
                ],
                "connectDomains": [
                  "https://api.stripe.com",
                  "https://m.stripe.com",
                  "https://r.stripe.com",
                  "https://q.stripe.com",
                  "https://errors.stripe.com",
                  "https://api.conformance.test"
                ],
                "frameDomains": ["https://js.stripe.com", "https://hooks.stripe.com"]
              },
              "prefersBorder": true
            }
          }
        }
      ]
    }
  }
}
