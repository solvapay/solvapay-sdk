{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    // Keep `@solvapay/server` as a real package import during the library
    // build so tsup can externalize it. Path-mapping to server/src would
    // pull the native/WASM barrel into the React client bundle.
    "paths": {
      "@solvapay/mcp-core": ["../mcp-core/src"],
      "@solvapay/core": ["../core/src"],
      "@solvapay/core/portable": ["../core/src/portable-fallbacks"]
    }
  },
  "references": [],
  "exclude": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/*.test-d.ts"]
}
