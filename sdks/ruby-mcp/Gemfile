# frozen_string_literal: true

source "https://rubygems.org"

# Do not `gemspec` here: that would make Bundler resolve `solvapay` from
# rubygems and compile Magnus from source. CI `gem install`s the platform
# artifact; local monorepo runs use RUBYLIB against sdks/ruby/lib.
gem "mcp", "~> 1.3"
gem "minitest"
gem "rake"

group :typecheck do
  gem "rbs", "4.0.3"
  gem "steep", "2.0.0"
  gem "rubocop", "1.88.2"
end
