/**
 * Wrangler config for the SolvaPay Rust MCP Cloudflare Worker.
 *
 * `worker-build` emits `build/worker/shim.mjs`. The widget HTML is compiled
 * into `solvapay-mcp` (`MCP_APP_HTML`) — there is no Vite step.
 *
 * `SOLVAPAY_SECRET_KEY` is a secret:
 *   wrangler secret put SOLVAPAY_SECRET_KEY
 */
{
  "name": "solvapay-mcp-rust-worker",
  "main": "build/worker/shim.mjs",
  "compatibility_date": "2026-04-26",
  "build": {
    "command": "cargo install -q worker-build && worker-build --release"
  },
  "vars": {
    "SOLVAPAY_PRODUCT_REF": "prd_your_product_ref",
    "MCP_PUBLIC_BASE_URL": "https://your-worker.example.com"
  },
  "observability": {
    "enabled": true
  }
}
