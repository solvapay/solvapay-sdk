SOLVAPAY_SECRET_KEY=sk_sandbox_your_key_here
SOLVAPAY_API_BASE_URL=http://localhost:3010
SOLVAPAY_PRODUCT=prd_your_product_ref
MCP_HOST=127.0.0.1
# Must match the platform `mcpapp` ngrok tunnel (appmcp.* → localhost:3030).
# Only one MCP example can own this origin at a time.
MCP_PORT=3030
# Same reserved origin as Python stock-research. Reserve appmcp.your-subdomain
# in your ngrok account. Do not point it at the mcp-proxy wildcard
# (`*.local.your-subdomain.ngrok.app`).
WEATHER_MCP_NGROK_URL=https://appmcp.your-subdomain.ngrok.app
# Required for --mode serve and --mode http. HTTPS origin only (no path,
# no trailing slash). Checkout and widget URLs are built from it.
MCP_PUBLIC_BASE_URL=https://appmcp.your-subdomain.ngrok.app
# live | fixture — live calls Open-Meteo (no API key); fixture is offline London.
WEATHER_MCP_SOURCE=live
