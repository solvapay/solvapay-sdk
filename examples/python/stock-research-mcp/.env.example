SOLVAPAY_SECRET_KEY=sk_sandbox_your_key_here
SOLVAPAY_API_BASE_URL=http://localhost:3010
SOLVAPAY_PRODUCT=prd_your_product_ref
# Must match the platform `mcpapp` ngrok tunnel (appmcp.* → localhost:3030).
MCP_PORT=3030
MCP_HOST=127.0.0.1
# Python stock-research is the process behind this reserved origin. Do not
# point it at the mcp-proxy wildcard (`*.local.jack-local.ngrok.app`).
STOCK_RESEARCH_NGROK_URL=https://appmcp.jack-local.ngrok.app
MCP_PUBLIC_BASE_URL=https://appmcp.jack-local.ngrok.app
# tools-call (default): only tools/call needs a bearer. all: every JSON-RPC
# method is challenged so MCPJam Auto prompts OAuth at connect.
# MCPJam's server-card toggle reuses stored credentials only — use Reconnect
# (or remove and re-add the server) to open a consent screen.
# MCP_AUTH_MODE=all
