{
  "name": "@example/cloudflare-workers-mcp-python",
  "private": true,
  "type": "module",
  "description": "Beta Cloudflare Python Worker for SolvaPay MCP via @solvapay/server-wasm FFI.",
  "scripts": {
    "predev": "pnpm --filter @solvapay/server-wasm run build:wasm",
    "dev": "uv run pywrangler dev",
    "deploy": "uv run pywrangler deploy"
  },
  "dependencies": {
    "@solvapay/server-wasm": "workspace:*"
  },
  "devDependencies": {
    "wrangler": "^4.47.0"
  }
}
