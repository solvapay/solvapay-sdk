{
  "name": "solvapay-mcp-python-worker",
  "main": "src/worker.py",
  "compatibility_date": "2026-04-26",
  "compatibility_flags": ["python_workers"],
  "vars": {
    "SOLVAPAY_PRODUCT_REF": "prd_your_product_ref",
    "MCP_PUBLIC_BASE_URL": "https://your-worker.example.com"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "dev": {
      "name": "solvapay-mcp-goldberg-python-dev",
      "compatibility_flags": ["python_workers"],
      "routes": [
        {
          "pattern": "goldberg-python-dev.solvapay.app",
          "custom_domain": true
        }
      ],
      "vars": {
        "SOLVAPAY_PRODUCT_REF": "prd_replace_me",
        "MCP_PUBLIC_BASE_URL": "https://goldberg-python-dev.solvapay.app",
        "SOLVAPAY_API_BASE_URL": "https://api-dev.solvapay.com"
      },
      "observability": {
        "enabled": true
      }
    }
  }
}
