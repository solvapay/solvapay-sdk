# Opper clone: a stand-in for Opper's API that integrates the SolvaPay SDK.
# Copy to .env (git-ignored) and fill in. Never commit real values.

# Port the clone listens on. Claude Code uses ANTHROPIC_BASE_URL=http://localhost:3040/v3/compat
PORT=3040

# Upstream Opper API
OPPER_BASE_URL=https://api.opper.ai
# Management key (op-mak-...) from SolvaPay's Opper organisation; mints a project and key per user
OPPER_MANAGEMENT_KEY=

# 32-byte base64 key that encrypts the per-user Opper keys at rest (data/kv.json)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CLONE_KEY_ENCRYPTION_KEY=

# SolvaPay, local platform stack. The provider-app proxy on :3010 routes /v1/* to the services.
SOLVAPAY_API_BASE_URL=http://localhost:3010
# Sandbox secret key (sk_sandbox_...) of the provider "Opper (clone)"
SOLVAPAY_SECRET_KEY=
# Product reference (prd_...) of "Opper inference"
SOLVAPAY_PRODUCT_REF=

# SolvaPay agent tokens (agent payments PoC, S2). The issuer is <platform backendUrl>/v1/agent;
# the JWKS can be fetched from the local proxy.
SOLVAPAY_AGENT_ISSUER=https://api.tommy-local.ngrok.app/v1/agent
SOLVAPAY_AGENT_JWKS_URL=http://localhost:3010/v1/agent/jwks.json
# This merchant's provider reference (prov_...); agent tokens must name it as their audience
SOLVAPAY_PROVIDER_REF=

# Port of the local card page that `pnpm agent:connect card` serves (S3). Optional.
# CARD_PAGE_PORT=3041
