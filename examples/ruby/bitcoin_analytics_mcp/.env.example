SOLVAPAY_SECRET_KEY=sk_sandbox_your_key_here
SOLVAPAY_API_BASE_URL=https://api-dev.solvapay.com
SOLVAPAY_PRODUCT=prd_your_product_ref
# Must match the platform `mcpapp` ngrok tunnel (appmcp.* → localhost:3030).
# Only one MCP example can own this origin at a time.
MCP_PORT=3030
MCP_HOST=127.0.0.1
# Same reserved origin as Python stock-research. Do not point it at the
# mcp-proxy wildcard (`*.local.jack-local.ngrok.app`).
BITCOIN_ANALYTICS_NGROK_URL=https://appmcp.jack-local.ngrok.app
MCP_PUBLIC_BASE_URL=https://appmcp.jack-local.ngrok.app
# live | fixture
MCP_SOURCE=live
