# Dev values for the goldberg Go container Worker (`pnpm deploy:go`).
#
# This product must expose a `requests` meter — weather-mcp debits 1 unit
# per tool call.
#
# SOLVAPAY_SECRET_KEY is NOT re-uploaded on each deploy. Set it once:
#   pnpm exec wrangler secret put SOLVAPAY_SECRET_KEY --env go
#
# Copy this file to `.env.go.dev` and fill in real dev values.

SOLVAPAY_SECRET_KEY=sk_test_your_dev_key_here
SOLVAPAY_PRODUCT=prd_your_dev_product_ref
MCP_PUBLIC_BASE_URL=https://mcp-go-dev.solvapay.app
SOLVAPAY_API_BASE_URL=https://api-dev.solvapay.com
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
