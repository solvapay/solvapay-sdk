# Dev values for the goldberg Ruby container Worker (`pnpm deploy:ruby`).
#
# This product must expose a `requests` meter — bitcoin analytics debits
# 1 unit per tool call.
#
# SOLVAPAY_SECRET_KEY is NOT re-uploaded on each deploy. Set it once:
#   pnpm exec wrangler secret put SOLVAPAY_SECRET_KEY --env ruby
#
# Copy this file to `.env.ruby.dev` and fill in real dev values.

SOLVAPAY_SECRET_KEY=sk_test_your_dev_key_here
SOLVAPAY_PRODUCT=prd_your_dev_product_ref
MCP_PUBLIC_BASE_URL=https://mcp-ruby-dev.solvapay.app
SOLVAPAY_API_BASE_URL=https://api-dev.solvapay.com
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
