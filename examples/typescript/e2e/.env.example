# Merchant + platform env for the example e2e suite.
#
# Copy to `.env` in this directory (gitignored) or export the same variables
# before running `pnpm test:e2e:examples` from the repo root.
#
# Prerequisites, in order:
#   1. Platform stack running locally (from the platform repo): `npm run local`.
#      That also starts the Stripe webhook forwarder, which the demos need to
#      observe an activated purchase after a card is charged.
#   2. In the local provider console (http://localhost:3010), pick the
#      environment whose Stripe account is in TEST mode — normally sandbox.
#      In it, create a product with at least one paid, non-usage-based plan,
#      and a secret key.
#
# Global setup verifies the Stripe mode against the platform itself rather than
# guessing from the key prefix, and fails the run if it is live mode.

# provider-app's /v1 proxy — the only local process that fans /v1/* out across
# the provider, payment, billing and commerce services. Not :3001.
SOLVAPAY_API_BASE_URL=http://127.0.0.1:3010

# Secret key for that environment.
SOLVAPAY_SECRET_KEY=sk_sandbox_...

# Product under test. Must live in the same environment as the key and expose
# at least one paid plan.
SOLVAPAY_PRODUCT_REF=prd_...
