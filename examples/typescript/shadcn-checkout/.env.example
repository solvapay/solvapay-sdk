# Product reference exposed to the client (PlanSelector.Root productRef)
NEXT_PUBLIC_SOLVAPAY_PRODUCT_REF=prd_demo

# Optional: set a real SolvaPay secret key to swap the stub for the real backend.
# When unset, lib/solvapay.ts falls back to the shared stub client so the
# example runs end-to-end without backend dependencies.
# SOLVAPAY_SECRET_KEY=
# Local platform provider-app proxy (only used when SOLVAPAY_SECRET_KEY is set).
SOLVAPAY_API_BASE_URL=http://localhost:3010
