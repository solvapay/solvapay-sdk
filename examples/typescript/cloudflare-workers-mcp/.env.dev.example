# Dev values for the goldberg-demo dev Worker.
#
# `pnpm deploy:dev` (example-deploy --target dev) sources this file and
# passes the overridable vars through to:
#   wrangler deploy --env dev --var KEY:VALUE …
#
# SOLVAPAY_SECRET_KEY is NOT re-uploaded on each deploy. Set it once:
#   pnpm exec wrangler secret put SOLVAPAY_SECRET_KEY --env dev
# It persists across deploys on the dev Worker (solvapay-mcp-goldberg-dev).
# Kept here so `wrangler dev --env dev` can read it for the
# (rare) case of running dev config locally.
#
# Copy this file to `.env.dev` and fill in real dev values. The
# copy is gitignored; never commit it.

# DEV merchant secret key (sk_test_… or sk_sandbox_…). Console dev / sandbox.
SOLVAPAY_SECRET_KEY=sk_test_your_dev_key_here

# DEV product ref the paywall gates on (prd_…). Must be a product
# created on the dev merchant account.
SOLVAPAY_PRODUCT_REF=prd_your_dev_product_ref

# Canonical public URL the dev Worker answers at. Used by the OAuth
# `issuer` and the MCP `publicBaseUrl`. Leave as-is unless you're
# pointing the dev deploy at a different hostname.
MCP_PUBLIC_BASE_URL=https://goldberg-demo-dev.solvapay.app

# SolvaPay API origin — required for dev; must point at api-dev.
SOLVAPAY_API_BASE_URL=https://api-dev.solvapay.com

# SolvaPay Cloudflare org (from `wrangler whoami`). Not a Worker var;
# forwarded as process env so deploys do not land on a personal account.
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id

# Keep the demo tools (predict_price_chart, predict_direction)
# registered on the dev demo. Flip to "0" to retire them.
DEMO_TOOLS=1
