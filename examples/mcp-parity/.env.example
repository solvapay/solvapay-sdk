# Shared by the three servers. Copy to .env and fill in every value.
# Keep comments on their own lines: the Go server reads this file without a
# dotenv library.

# A sandbox secret key and a product with an active plan, from the console of
# the stack below.
SOLVAPAY_SECRET_KEY=sk_sandbox_...
SOLVAPAY_PRODUCT_REF=prd_...

# The local platform (provider-app proxy on :3010), or a deployed API.
SOLVAPAY_API_BASE_URL=http://localhost:3010

# One port and one ngrok domain per server. The public URL is the OAuth
# issuer clients see, so it must match the domain in ngrok.yml exactly.
TS_PORT=3040
TS_PUBLIC_BASE_URL=https://mcp-ts.your-subdomain.ngrok.app
PY_PORT=3041
PY_PUBLIC_BASE_URL=https://mcp-py.your-subdomain.ngrok.app
GO_PORT=3042
GO_PUBLIC_BASE_URL=https://mcp-go.your-subdomain.ngrok.app
