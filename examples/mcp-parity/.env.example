# Shared by the six servers. Copy to .env and fill in every value.
# Keep comments on their own lines: the Go servers read this file without a
# dotenv library.

# --- The merchant ---------------------------------------------------------
# A sandbox secret key and a product with an active plan, from the console of
# the stack below. The agents servers also need the merchant's provider
# reference (agent tokens are issued for it) and agent payments turned on.
SOLVAPAY_SECRET_KEY=sk_sandbox_...
SOLVAPAY_PRODUCT_REF=prd_...
SOLVAPAY_PROVIDER_REF=prov_...

# The local platform (provider-app proxy on :3010), or a deployed API.
SOLVAPAY_API_BASE_URL=http://localhost:3010

# --- Agent payments (agents servers only) ---------------------------------
# The iss SolvaPay's agent service signs with (locally: the platform API's
# ngrok URL), and where its public keys are read from.
SOLVAPAY_AGENT_ISSUER=https://api.your-subdomain.ngrok.app/v1/agent
SOLVAPAY_AGENT_JWKS_URL=http://localhost:3010/v1/agent/jwks.json
# How long an agent's call waits for its owner to answer an approval, 0 to
# 55 seconds; 0 refuses at once. Keep it under the MCP client's timeout.
APPROVAL_WAIT_SECONDS=50
# on: hosts such as Claude sign in with SolvaPay's agent OAuth, and /mcp is
# the OAuth resource. off: agents bring a token or agent key themselves, and
# hosts get the customer sign-in.
AGENT_OAUTH=off

# --- Where clients reach each server ---------------------------------------
# One ngrok domain per server. The URL is the OAuth issuer clients see, so it
# must match the domain in ngrok.yml exactly.
PAYWALL_TS_URL=https://paywall-ts.your-subdomain.ngrok.app
PAYWALL_PY_URL=https://paywall-py.your-subdomain.ngrok.app
PAYWALL_GO_URL=https://paywall-go.your-subdomain.ngrok.app
AGENTS_TS_URL=https://agents-ts.your-subdomain.ngrok.app
AGENTS_PY_URL=https://agents-py.your-subdomain.ngrok.app
AGENTS_GO_URL=https://agents-go.your-subdomain.ngrok.app
