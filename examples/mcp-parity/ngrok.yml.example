# The six parity servers' tunnels. Copy to ngrok.yml and replace
# your-subdomain with the domains you reserved in the ngrok dashboard. The
# authtoken stays in ngrok's own config (ngrok config add-authtoken).
#
# If your ngrok plan allows one agent at a time and the platform's tunnels are
# running, add these tunnels to the platform's ngrok.yml instead and run
# ./start.sh --no-ngrok.
version: '3'
tunnels:
  paywall-ts:
    proto: http
    addr: 3060
    domain: paywall-ts.your-subdomain.ngrok.app
  paywall-py:
    proto: http
    addr: 3061
    domain: paywall-py.your-subdomain.ngrok.app
  paywall-go:
    proto: http
    addr: 3062
    domain: paywall-go.your-subdomain.ngrok.app
  agents-ts:
    proto: http
    addr: 3070
    domain: agents-ts.your-subdomain.ngrok.app
  agents-py:
    proto: http
    addr: 3071
    domain: agents-py.your-subdomain.ngrok.app
  agents-go:
    proto: http
    addr: 3072
    domain: agents-go.your-subdomain.ngrok.app
