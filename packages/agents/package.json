{
  "name": "@solvapay/agents",
  "version": "0.0.0",
  "type": "module",
  "description": "SolvaPay agent payments for merchants (preview): verify agent tokens, authorize and complete each paid call, report usage, with adapters for MCP servers (/mcp) and HTTP APIs (/http). Everything else runs in SolvaPay.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "development": "./src/mcp.ts",
      "import": "./dist/mcp.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "development": "./src/http.ts",
      "import": "./dist/http.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "development": "./src/testing.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "bin": {
    "solvapay-agents": "./bin/solvapay-agents.mjs"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "dependencies": {
    "@solvapay/core": "workspace:*",
    "@solvapay/server": "workspace:*",
    "jose": "^6.2.2",
    "solvapay": "workspace:*"
  },
  "devDependencies": {
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@types/node": "^25.5.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.3",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@modelcontextprotocol/server": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/server": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./mcp": {
        "types": "./dist/mcp.d.ts",
        "import": "./dist/mcp.js"
      },
      "./http": {
        "types": "./dist/http.d.ts",
        "import": "./dist/http.js"
      },
      "./testing": {
        "types": "./dist/testing.d.ts",
        "import": "./dist/testing.js"
      }
    }
  }
}
