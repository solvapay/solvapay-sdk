{
  "name": "@solvapay/agents",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "SolvaPay agent payments for merchants (preview): verify agent tokens, authorize and complete each paid call, report usage, with adapters for MCP servers (/mcp) and HTTP APIs (/http). Everything else runs in SolvaPay.",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./mcp": "./src/mcp.ts",
    "./http": "./src/http.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@solvapay/server": "workspace:*",
    "jose": "^6.2.2"
  },
  "devDependencies": {
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@types/node": "^25.5.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.3",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@modelcontextprotocol/server": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/server": {
      "optional": true
    }
  }
}
