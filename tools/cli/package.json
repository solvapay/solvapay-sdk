{
  "name": "solvapay",
  "version": "1.4.0",
  "description": "SolvaPay CLI",
  "type": "module",
  "bin": {
    "solvapay": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/solvapay/solvapay-sdk.git",
    "directory": "tools/cli"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "dependencies": {
    "@solvapay/init": "workspace:^",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@solvapay/tsconfig": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  },
  "exports": {
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "import": "./dist/agent/index.js"
    }
  }
}
