{
  "suite": "descriptors",
  "case": "views-checkout-only",
  "input": {
    "fn": "mcpDescriptors",
    "args": {
      "resourceUri": "ui://test/view.html",
      "publicBaseUrl": "https://app.example.com",
      "productRef": "prd_demo",
      "views": [
        "checkout"
      ]
    }
  },
  "expect": {
    "result": {
      "tools": [
        {
          "name": "upgrade",
          "title": "Upgrade plan",
          "description": "Start or change a paid plan for the current customer. On UI hosts this opens the embedded checkout; on text hosts returns a markdown summary with a checkout URL. This tool only returns a read-only snapshot or opens the UI \u2014 actual charges happen later in the embedded checkout after the customer confirms. Also available: manage_account (current plan + cancel/reactivate), activate_plan (pick or activate a specific plan), topup (add credits). By default (`mode: 'auto'`) returns a markdown summary with plan refs and a checkout URL and still opens the UI iframe on hosts that support it; pass `mode: 'text'` for markdown only, or `mode: 'ui'` for the iframe plus a one-line placeholder.",
          "meta": {
            "ui": {
              "resourceUri": "ui://test/view.html"
            }
          },
          "annotations": {
            "openWorldHint": true,
            "readOnlyHint": true,
            "idempotentHint": true
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "ui",
                  "text",
                  "auto"
                ]
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "view": {
                "type": "string"
              },
              "productRef": {
                "type": "string"
              },
              "checkoutUrl": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "portalUrl": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "plans": {
                "type": "array"
              },
              "customer": {},
              "product": {},
              "merchant": {}
            }
          }
        },
        {
          "name": "create_checkout_session",
          "description": "UI-only; agents should prefer `upgrade` / `manage_account` / `activate_plan`. Create a SolvaPay hosted checkout session and return its URL. The UI opens this URL in a new tab when Stripe Elements is blocked by the host sandbox.",
          "meta": {
            "ui": {
              "resourceUri": "ui://test/view.html",
              "visibility": [
                "app"
              ]
            },
            "audience": "ui",
            "openai/widgetAccessible": true
          },
          "annotations": {
            "openWorldHint": true
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "planRef": {
                "type": "string"
              },
              "productRef": {
                "type": "string"
              }
            }
          }
        },
        {
          "name": "create_payment_intent",
          "description": "UI-only; agents should prefer `upgrade` / `manage_account` / `activate_plan`. Create a Stripe payment intent for the authenticated customer to purchase a plan. Returns { clientSecret, publishableKey, accountId?, customerRef } for confirmation with Stripe Elements in the app UI.",
          "meta": {
            "ui": {
              "resourceUri": "ui://test/view.html",
              "visibility": [
                "app"
              ]
            },
            "audience": "ui",
            "openai/widgetAccessible": true
          },
          "annotations": {
            "openWorldHint": true
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "planRef": {
                "type": "string"
              },
              "productRef": {
                "type": "string"
              },
              "currency": {
                "type": "string"
              }
            },
            "required": [
              "planRef",
              "productRef"
            ]
          }
        },
        {
          "name": "process_payment",
          "description": "UI-only; agents should prefer `upgrade` / `manage_account` / `activate_plan`. Process a Stripe payment intent after client-side confirmation and create the SolvaPay purchase. Call after confirmPayment resolves to short-circuit webhook latency.",
          "meta": {
            "ui": {
              "resourceUri": "ui://test/view.html",
              "visibility": [
                "app"
              ]
            },
            "audience": "ui",
            "openai/widgetAccessible": true
          },
          "annotations": {
            "openWorldHint": true,
            "destructiveHint": true
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "paymentIntentId": {
                "type": "string"
              },
              "productRef": {
                "type": "string"
              },
              "planRef": {
                "type": "string"
              }
            },
            "required": [
              "paymentIntentId",
              "productRef"
            ]
          }
        },
        {
          "name": "create_customer_session",
          "description": "UI-only; agents should prefer `upgrade` / `manage_account` / `activate_plan`. Create a SolvaPay hosted customer portal session and return its URL. Used to let a paid customer manage or cancel their purchase in a new tab.",
          "meta": {
            "ui": {
              "resourceUri": "ui://test/view.html",
              "visibility": [
                "app"
              ]
            },
            "audience": "ui",
            "openai/widgetAccessible": true
          },
          "annotations": {
            "openWorldHint": true,
            "readOnlyHint": true,
            "idempotentHint": true
          },
          "inputSchema": {
            "type": "object",
            "properties": {}
          }
        },
        {
          "name": "create_topup_payment_intent",
          "description": "UI-only; agents should prefer `upgrade` / `manage_account` / `activate_plan`. Create a Stripe payment intent for a credit top-up. Credits are recorded by the SolvaPay webhook after confirmation.",
          "meta": {
            "ui": {
              "resourceUri": "ui://test/view.html",
              "visibility": [
                "app"
              ]
            },
            "audience": "ui",
            "openai/widgetAccessible": true
          },
          "annotations": {
            "openWorldHint": true
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "amount": {
                "type": "integer"
              },
              "currency": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "amount",
              "currency"
            ]
          }
        },
        {
          "name": "attach_business_details",
          "description": "UI-only; agents should prefer `upgrade` / `manage_account` / `activate_plan`. Attach business purchase details to a payment intent and retrieve the computed tax breakdown.",
          "meta": {
            "ui": {
              "resourceUri": "ui://test/view.html",
              "visibility": [
                "app"
              ]
            },
            "audience": "ui",
            "openai/widgetAccessible": true
          },
          "annotations": {
            "openWorldHint": true
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "paymentIntentId": {
                "type": "string"
              },
              "isBusiness": {
                "type": "boolean"
              },
              "businessName": {
                "type": "string"
              },
              "country": {
                "type": "string"
              },
              "taxId": {
                "type": "string"
              },
              "taxIdType": {
                "type": "string",
                "enum": [
                  "eu_vat",
                  "gb_vat",
                  "us_ein"
                ]
              }
            },
            "required": [
              "paymentIntentId",
              "isBusiness"
            ]
          }
        },
        {
          "name": "cancel_renewal",
          "description": "UI-only; agents should prefer `upgrade` / `manage_account` / `activate_plan`. Cancel the auto-renewal on an active purchase. Backend keeps access until the current period ends.",
          "meta": {
            "ui": {
              "resourceUri": "ui://test/view.html",
              "visibility": [
                "app"
              ]
            },
            "audience": "ui",
            "openai/widgetAccessible": true
          },
          "annotations": {
            "openWorldHint": true,
            "destructiveHint": true,
            "idempotentHint": true
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "purchaseRef": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "purchaseRef"
            ]
          }
        },
        {
          "name": "reactivate_renewal",
          "description": "UI-only; agents should prefer `upgrade` / `manage_account` / `activate_plan`. Undo a pending cancellation so auto-renewal resumes. Only valid while the purchase is still active and its end date hasn't passed.",
          "meta": {
            "ui": {
              "resourceUri": "ui://test/view.html",
              "visibility": [
                "app"
              ]
            },
            "audience": "ui",
            "openai/widgetAccessible": true
          },
          "annotations": {
            "openWorldHint": true,
            "idempotentHint": true
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "purchaseRef": {
                "type": "string"
              }
            },
            "required": [
              "purchaseRef"
            ]
          }
        },
        {
          "name": "activate_plan",
          "title": "Activate plan",
          "description": "Activate a plan for the current customer. With a `planRef`: free plans activate immediately; usage-based plans activate when the balance covers the configured usage; paid plans return a markdown checkout link on text hosts or open the embedded checkout on UI hosts. Without a `planRef`: returns the available plans so the customer can pick \u2014 UI hosts render the embedded checkout picker, text hosts see a plans list. Also available: upgrade (direct to checkout), manage_account (current plan + usage), topup (add credits). By default (`mode: 'auto'`) returns a markdown summary with plan refs and a checkout URL and still opens the UI iframe on hosts that support it; pass `mode: 'text'` for markdown only, or `mode: 'ui'` for the iframe plus a one-line placeholder.",
          "meta": {
            "ui": {
              "resourceUri": "ui://test/view.html"
            }
          },
          "annotations": {
            "openWorldHint": true
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "productRef": {
                "type": "string"
              },
              "planRef": {
                "type": "string"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "ui",
                  "text",
                  "auto"
                ]
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "view": {
                "type": "string"
              },
              "productRef": {
                "type": "string"
              },
              "checkoutUrl": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "portalUrl": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "plans": {
                "type": "array"
              },
              "customer": {},
              "product": {},
              "merchant": {}
            }
          }
        }
      ],
      "prompts": [
        {
          "name": "upgrade",
          "title": "Upgrade plan",
          "description": "Start or change a paid plan for the current customer."
        },
        {
          "name": "activate_plan",
          "title": "Activate plan",
          "description": "Pick a plan to activate, or activate a specific plan by ref."
        }
      ],
      "csp": {
        "resourceDomains": [
          "https://js.stripe.com",
          "https://*.stripe.com",
          "https://b.stripecdn.com"
        ],
        "connectDomains": [
          "https://api.stripe.com",
          "https://m.stripe.com",
          "https://r.stripe.com",
          "https://q.stripe.com",
          "https://errors.stripe.com"
        ],
        "frameDomains": [
          "https://js.stripe.com",
          "https://hooks.stripe.com"
        ]
      },
      "docs": {
        "uri": "docs://solvapay/overview.md",
        "name": "SolvaPay MCP \u2014 overview",
        "title": "SolvaPay overview",
        "description": "Agent-facing \"start here\" doc \u2014 explains the five intent tools, dual-audience fallback, and auth model before any tool is called.",
        "mimeType": "text/markdown"
      },
      "bootstrap": {
        "uri": "solvapay://bootstrap.json",
        "name": "SolvaPay bootstrap",
        "title": "SolvaPay bootstrap",
        "description": "Current merchant/product/plans/customer snapshot for the embedded UI. Widgets read this idempotently when the host scrubs structuredContent from tool results.",
        "mimeType": "application/json"
      },
      "resource": {
        "uri": "ui://test/view.html",
        "mimeType": "text/html;profile=mcp-app",
        "csp": {
          "resourceDomains": [
            "https://js.stripe.com",
            "https://*.stripe.com",
            "https://b.stripecdn.com"
          ],
          "connectDomains": [
            "https://api.stripe.com",
            "https://m.stripe.com",
            "https://r.stripe.com",
            "https://q.stripe.com",
            "https://errors.stripe.com"
          ],
          "frameDomains": [
            "https://js.stripe.com",
            "https://hooks.stripe.com"
          ]
        }
      }
    }
  }
