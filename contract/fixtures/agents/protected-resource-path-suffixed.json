{
  "suite": "agents",
  "case": "protected-resource-path-suffixed",
  "input": {
    "fn": "agentProtectedResource",
    "args": {
      "input": {
        "resource": "https://mcp.example.com:443/mcp/",
        "authorizationServer": "https://api.solvapay.com/v1/agent",
        "serverName": "Acme"
      }
    }
  },
  "expect": {
