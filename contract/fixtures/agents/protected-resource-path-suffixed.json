      "metadata": {
        "resource": "https://mcp.example.com/mcp",
        "authorization_servers": [
          "https://api.solvapay.com/v1/agent"
        ],
        "scopes_supported": [
          "usage"
        ],
        "bearer_methods_supported": [
          "header"
        ],
        "resource_name": "Acme"
      }
    }
  }
}
