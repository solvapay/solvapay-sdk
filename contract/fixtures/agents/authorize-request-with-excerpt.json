{
  "suite": "agents",
  "case": "authorize-request-with-excerpt",
  "input": {
    "fn": "agentAuthorizeRequest",
    "args": {
      "input": {
        "agentToken": "t",
        "requestId": "req_1",
        "item": "gpt-5",
        "estimate": {
          "amount": "0.02",
          "currency": "USD"
        },
        "prompt": {
          "promptHash": "sha256:abc",
          "toolError": false,
          "excerpt": "tail"
        },
        "promptExcerptAllowed": true,
        "nowMs": 1000,
        "deadlineMs": 11000
      }
    }
  },
  "expect": {
    "result": {
      "agentToken": "t",
      "requestId": "req_1",
      "item": "gpt-5",
      "estimate": {
        "amount": "0.02",
        "currency": "USD"
      },
      "wait": 10,
      "promptHash": "sha256:abc",
      "toolError": false,
      "promptExcerpt": "tail"
    }
  }
}
