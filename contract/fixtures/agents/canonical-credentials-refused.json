{
  "suite": "agents",
  "case": "canonical-credentials-refused",
  "input": {
    "fn": "agentCanonicalResource",
    "args": {
      "resource": "https://user:pw@example.com/mcp"
    }
  },
  "expect": {
    "result": {
      "ok": false,
      "error": "https://user:pw@example.com/mcp cannot be an OAuth resource: no fragment or credentials"
    }
  }
}
