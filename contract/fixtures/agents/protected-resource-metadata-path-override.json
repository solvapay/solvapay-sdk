{
  "suite": "agents",
  "case": "protected-resource-metadata-path-override",
  "input": {
    "fn": "agentProtectedResource",
    "args": {
      "resource": {
        "resource": "https://mcp.example.com/mcp",
        "authorizationServer": "https://api.solvapay.test/v1/agent",
        "metadataPath": "/meta"
      }
    }
  },
  "expect": {
    "result": {
      "ok": true,
      "resource": "https://mcp.example.com/mcp",
      "path": "/meta",
