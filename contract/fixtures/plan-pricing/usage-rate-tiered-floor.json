{
  "suite": "plan-pricing",
  "case": "usage-rate-tiered-floor",
  "input": {
    "fn": "usageRate",
    "args": {
      "priced": {
        "type": "usage-based",
        "price": 0,
        "currency": "USD",
        "options": [
          {
            "kind": "tier",
            "from": 1000,
            "to": null,
            "mode": "graduated",
            "charge": { "per": "unit", "amountMinor": 1, "currency": "USD", "meter": "requests" }
          },
          {
            "kind": "tier",
            "from": 0,
            "to": 1000,
            "mode": "graduated",
            "charge": { "per": "unit", "amountMinor": 2, "currency": "USD", "meter": "requests" }
          }
        ]
      }
    }
  },
  "expect": {
    "result": {
      "per": "unit",
      "amountMinor": 2,
      "currency": "USD",
      "meter": "requests",
      "tiered": true
    }
  }
}
