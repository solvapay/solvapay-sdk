{
  "suite": "mcp",
  "case": "minimal-trailing-json",
  "input": {
    "fn": "buildPayableToolResult",
    "args": {
      "envelope": {
        "__solvapayResponse": true,
        "data": {
          "foo": "bar",
          "list": [1, 2, 3]
        }
      }
    }
  },
  "expect": {
    "result": {
      "content": [
        {
          "type": "text",
          "text": "{\"foo\":\"bar\",\"list\":[1,2,3]}"
        }
      ],
      "structuredContent": {
        "foo": "bar",
        "list": [1, 2, 3]
      }
    }
  }
}
