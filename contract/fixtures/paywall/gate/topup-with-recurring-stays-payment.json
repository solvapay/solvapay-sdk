{
  "suite": "paywall",
  "case": "topup-with-recurring-stays-payment",
  "input": {
    "fn": "buildPaywallGate",
    "args": {
      "productRef": "prd_demo",
      "limits": {
        "plan": "pl_pro",
        "remaining": 0,
        "checkoutUrl": "https://pay.test/x",
        "plans": [
          {
            "reference": "pl_pro",
            "type": "usage-based",
            "requiresPayment": true
          },
          {
            "reference": "pl_pro",
            "type": "recurring",
            "requiresPayment": true
          }
        ],
        "balance": {
          "creditBalance": 0,
          "creditsPerUnit": 1,
          "currency": "usd"
        }
      }
    }
  },
  "expect": {
    "result": {
      "kind": "payment_required",
      "product": "prd_demo",
      "checkoutUrl": "https://pay.test/x",
      "message": "You're out of credits. Top up first ($10.00 \u00b7 $25.00 \u00b7 $50.00 \u00b7 $100.00). [Open checkout](https://pay.test/x) to add credits (expires in 15 minutes), or call the `topup` tool. See docs://solvapay/overview.md.",
      "balance": {
        "creditBalance": 0,
        "creditsPerUnit": 1,
        "currency": "usd"
      },
      "shortMessage": "Payment required",
      "planRef": "pl_pro",
      "plans": [
        {
          "reference": "pl_pro",
          "type": "usage-based",
          "requiresPayment": true
        },
        {
          "reference": "pl_pro",
          "type": "recurring",
          "requiresPayment": true
        }
      ],
      "creditBalance": 0
    }
  }
}
