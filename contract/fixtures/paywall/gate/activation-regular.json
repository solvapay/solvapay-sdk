{
  "suite": "paywall",
  "case": "activation-regular",
  "input": {
    "fn": "buildPaywallGate",
    "args": {
      "productRef": "prd_demo",
      "limits": {
        "plan": "pl_pro",
        "remaining": 0,
        "activationRequired": true,
        "confirmationUrl": "https://pay.test/confirm",
        "checkoutUrl": "https://pay.test/x",
        "plans": [
          {
            "reference": "pl_pro",
