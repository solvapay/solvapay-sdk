      "confirmationUrl": "https://pay.test/confirm",
      "plans": [
        {
          "reference": "pl_pro",
          "type": "usage-based",
          "requiresPayment": true
        }
      ],
      "shortMessage": "Activation required",
      "planRef": "pl_pro"
    }
  }
}
