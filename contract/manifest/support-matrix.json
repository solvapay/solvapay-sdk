{
  "version": 1,
  "notSupported": {
    "architectures": [
      "armv7",
      "i686",
      "ppc64le",
      "s390x",
      "riscv64"
    ],
    "reason": "No prebuilt artifacts and no supported source-build CI row."
  },
  "python": {
    "cpython": [
      "3.9",
      "3.10",
      "3.11",
      "3.12",
      "3.13",
      "3.14"
    ],
    "abi": "abi3-py39",
    "freeThreaded": "not-supported",
    "manylinux": "manylinux2014",
    "manylinuxWheelTags": [
      "manylinux2014",
      "manylinux_2_17"
    ],
    "wheels": [
      {
        "id": "manylinux-x86_64",
        "os": "ubuntu-latest",
        "target": "x86_64",
        "manylinux": "manylinux2014",
        "filenameIncludes": [
          "manylinux",
          "x86_64"
        ],
        "filenameExcludes": [
          "musl"
        ],
        "filenameAnyOf": []
      },
      {
        "id": "manylinux-aarch64",
        "os": "ubuntu-24.04-arm",
        "target": "aarch64",
        "manylinux": "manylinux2014",
        "filenameIncludes": [
          "manylinux"
        ],
        "filenameExcludes": [
          "musl"
        ],
        "filenameAnyOf": [
          "aarch64",
          "arm64"
        ]
      },
      {
        "id": "musllinux-x86_64",
        "os": "ubuntu-latest",
        "target": "x86_64",
        "manylinux": "musllinux_1_1",
        "filenameIncludes": [
          "musllinux",
          "x86_64"
        ],
        "filenameExcludes": [],
        "filenameAnyOf": []
      },
      {
        "id": "musllinux-aarch64",
        "os": "ubuntu-24.04-arm",
        "target": "aarch64",
        "manylinux": "musllinux_1_1",
        "filenameIncludes": [
          "musllinux"
        ],
        "filenameExcludes": [],
        "filenameAnyOf": [
          "aarch64",
          "arm64"
        ]
      },
      {
        "id": "macos-universal2",
        "os": "macos-latest",
        "target": "universal2-apple-darwin",
        "manylinux": "",
        "filenameIncludes": [
          "macosx",
          "universal2"
        ],
        "filenameExcludes": [],
        "filenameAnyOf": []
      },
      {
        "id": "win_amd64",
        "os": "windows-latest",
        "target": "x64",
        "manylinux": "",
        "filenameIncludes": [],
        "filenameExcludes": [],
        "filenameAnyOf": [
          "win_amd64",
          "win32"
        ]
      },
      {
        "id": "win_arm64",
        "os": "windows-11-arm",
        "target": "aarch64",
        "manylinux": "",
        "filenameIncludes": [
          "win_arm64"
        ],
        "filenameExcludes": [],
        "filenameAnyOf": []
      }
    ]
  },
  "ruby": {
    "abis": [
      "3.1",
      "3.2",
      "3.3",
      "3.4"
    ],
    "requiredRuby": ">= 3.0.0",
    "windows": "source-gem-only",
    "windowsReason": "rb-sys/bindgen fails in LLVM AVX10.2/AMX headers on mingw.",
    "gems": [
      {
        "id": "x86_64-linux",
        "os": "ubuntu-latest",
        "dock": true,
        "filenameIncludes": [
          "x86_64-linux"
        ],
        "filenameExcludes": [
          "musl"
        ],
        "filenameAnyOf": []
      },
      {
        "id": "aarch64-linux",
        "os": "ubuntu-latest",
        "dock": true,
        "filenameIncludes": [
          "aarch64-linux"
        ],
        "filenameExcludes": [
          "musl"
        ],
        "filenameAnyOf": []
      },
      {
        "id": "x86_64-linux-musl",
        "os": "ubuntu-latest",
        "dock": true,
        "filenameIncludes": [
          "x86_64-linux-musl"
        ],
        "filenameExcludes": [],
        "filenameAnyOf": []
      },
      {
        "id": "aarch64-linux-musl",
        "os": "ubuntu-latest",
        "dock": true,
        "filenameIncludes": [
          "aarch64-linux-musl"
        ],
        "filenameExcludes": [],
        "filenameAnyOf": []
      },
      {
        "id": "x86_64-darwin",
        "os": "macos-15-intel",
        "dock": true,
        "filenameIncludes": [
          "x86_64-darwin"
        ],
        "filenameExcludes": [],
        "filenameAnyOf": []
      },
      {
        "id": "arm64-darwin",
        "os": "macos-latest",
        "dock": true,
        "filenameIncludes": [
          "arm64-darwin"
        ],
        "filenameExcludes": [],
        "filenameAnyOf": []
      }
    ]
  },
  "nodeNative": {
    "nodeMajors": [
      "22",
      "24",
      "26"
    ],
    "targets": [
      {
        "dir": "darwin-x64",
        "packageName": "@solvapay/server-native-darwin-x64",
        "rustTriple": "x86_64-apple-darwin",
        "kind": "node",
        "binary": "server-native.darwin-x64.node",
        "platform": "darwin",
        "arch": "x64",
        "libc": null,
        "ciHost": "macos-15-intel",
        "ciContainer": null
      },
      {
        "dir": "darwin-arm64",
        "packageName": "@solvapay/server-native-darwin-arm64",
        "rustTriple": "aarch64-apple-darwin",
        "kind": "node",
        "binary": "server-native.darwin-arm64.node",
        "platform": "darwin",
        "arch": "arm64",
        "libc": null,
        "ciHost": "macos-15",
        "ciContainer": null
      },
      {
        "dir": "linux-x64-gnu",
        "packageName": "@solvapay/server-native-linux-x64-gnu",
        "rustTriple": "x86_64-unknown-linux-gnu",
        "kind": "node",
        "binary": "server-native.linux-x64-gnu.node",
        "platform": "linux",
        "arch": "x64",
        "libc": "glibc",
        "ciHost": "ubuntu-24.04",
        "ciContainer": null
      },
      {
        "dir": "linux-arm64-gnu",
        "packageName": "@solvapay/server-native-linux-arm64-gnu",
        "rustTriple": "aarch64-unknown-linux-gnu",
        "kind": "node",
        "binary": "server-native.linux-arm64-gnu.node",
        "platform": "linux",
        "arch": "arm64",
        "libc": "glibc",
        "ciHost": "ubuntu-24.04-arm",
        "ciContainer": null
      },
      {
        "dir": "linux-x64-musl",
        "packageName": "@solvapay/server-native-linux-x64-musl",
        "rustTriple": "x86_64-unknown-linux-musl",
        "kind": "node",
        "binary": "server-native.linux-x64-musl.node",
        "platform": "linux",
        "arch": "x64",
        "libc": "musl",
        "ciHost": "ubuntu-24.04",
        "ciContainer": "node:{nodeMajor}-alpine"
      },
      {
        "dir": "linux-arm64-musl",
        "packageName": "@solvapay/server-native-linux-arm64-musl",
        "rustTriple": "aarch64-unknown-linux-musl",
        "kind": "node",
        "binary": "server-native.linux-arm64-musl.node",
        "platform": "linux",
        "arch": "arm64",
        "libc": "musl",
        "ciHost": "ubuntu-24.04-arm",
        "ciContainer": "node:{nodeMajor}-alpine"
      },
      {
        "dir": "win32-x64-msvc",
        "packageName": "@solvapay/server-native-win32-x64-msvc",
        "rustTriple": "x86_64-pc-windows-msvc",
        "kind": "node",
        "binary": "server-native.win32-x64-msvc.node",
        "platform": "win32",
        "arch": "x64",
        "libc": null,
        "ciHost": "windows-latest",
        "ciContainer": null
      },
      {
        "dir": "win32-arm64-msvc",
        "packageName": "@solvapay/server-native-win32-arm64-msvc",
        "rustTriple": "aarch64-pc-windows-msvc",
        "kind": "node",
        "binary": "server-native.win32-arm64-msvc.node",
        "platform": "win32",
        "arch": "arm64",
        "libc": null,
        "ciHost": "windows-11-arm",
        "ciContainer": null
      }
    ]
  }
}
